<section class="content-wrap space-page breakout-page" data-breakout-live data-org-id="<%= selectedOrg.id %>" data-group-id="<%= group.id %>" data-user-id="<%= user.id %>" data-group-admin="<%= groupAdmin %>" data-members="<%= JSON.stringify(group.members.map(memberId => ({ id: memberId, name: (users.find(userRecord => userRecord.id === memberId) || { name: 'Member' }).name }))) %>">
  <a class="back-link" href="/org/<%= selectedOrg.id %>/course/<%= group.courseId %>/task/<%= group.taskSlug %>/breakout-groups"><i data-lucide="arrow-left"></i> All breakout groups</a>
  <div class="page-heading hero-heading"><div><p class="eyebrow">BREAKOUT GROUP</p><h1><%= group.name %></h1><p class="lead"><%= groupItem?.title || group.courseName %> · <%= group.members.length %>/<%= group.limit %> people</p></div></div>
  <div class="breakout-grid">
    <section class="rail-panel breakout-comments breakout-discussion">
      <div class="panel-heading"><div><p class="eyebrow">GROUP FORUM</p><h2>Discussion</h2></div><span class="muted"><%= (group.comments || []).filter(comment => !comment.parentId && !comment.reported).length %> threads</span></div>
      <div class="comment-list" data-breakout-comment-list>
        <% (group.comments || []).filter(comment => !comment.parentId && !comment.reported).forEach(comment => { %>
          <div class="comment-thread" data-comment-id="<%= comment.id %>">
            <div class="comment-entry"><div class="comment-body"><strong><%= comment.author %></strong> <%= comment.text %><% if (comment.editedAt) { %><small class="comment-edited">edited</small><% } %></div><% if (groupMember) { %><details class="reply-details"><summary class="reply-trigger"><i data-lucide="corner-down-right"></i> Reply</summary><form class="reply-form" data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/comments" method="post"><input type="hidden" name="parentId" value="<%= comment.id %>"><input name="comment" placeholder="Reply to this thread..." required><button class="button secondary" type="submit">Send reply</button></form></details><% } %><%- include('comment-actions', { comment, selectedOrg, group, user, groupAdmin }) %></div>
            <div class="comment-replies"><% (group.comments || []).filter(reply => reply.parentId === comment.id && !reply.reported).forEach(reply => { %><div class="comment-entry" data-comment-id="<%= reply.id %>"><div class="comment-body"><strong><%= reply.author %></strong> <%= reply.text %><% if (reply.editedAt) { %><small class="comment-edited">edited</small><% } %></div><%- include('comment-actions', { comment: reply, selectedOrg, group, user, groupAdmin }) %></div><% }) %></div>
          </div>
        <% }) %>
      </div>
      <% if (groupMember) { %><form class="comments-form" data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/comments" method="post"><input name="comment" placeholder="Start a discussion..." required><button class="button primary" type="submit">Post</button></form><% } else { %><p class="empty-panel">Join this group using its short link to participate in the discussion.</p><% } %>
    </section>
    <aside class="breakout-side">
      <section class="rail-panel breakout-board">
        <div class="panel-heading"><div><p class="eyebrow">SHARED BOARD</p><h2>Tasks</h2></div><span class="progress-ring"><%= (group.tasks || []).length %></span></div>
        <% if (groupMember) { %><form class="inline-tool-form task-add-form" data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks" method="post"><input name="title" placeholder="Add a shared task" required><button class="button secondary" type="submit">Add task</button></form><% } %>
        <div class="breakout-task-list" data-breakout-task-list>
          <% (group.tasks || []).forEach(task => { const claimedUser = users.find(userRecord => userRecord.id === task.claimedBy) || { name: 'a member' }; %>
            <article class="claim-row breakout-task <%= task.done ? 'is-done' : '' %>" data-task-id="<%= task.id %>"><span><strong><%= task.title %></strong><small><%= task.claimedBy ? `Claimed by ${claimedUser.name}` : 'Open' %></small></span><span class="task-actions"><% if (!task.claimedBy && groupMember) { %><form data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks/<%= task.id %>/claim" method="post"><button class="button secondary task-action" type="submit">Claim task</button></form><% } %><% if (groupAdmin || task.claimedBy === user.id) { %><details class="task-menu"><summary class="icon-button" aria-label="More actions for <%= task.title %>"><i data-lucide="ellipsis"></i></summary><div class="task-menu-popover"><% if (task.claimedBy) { %><form data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks/<%= task.id %>/unclaim" method="post"><button class="menu-action" type="submit">Unclaim task</button></form><% } %><% if (groupAdmin) { %><details class="inline-edit"><summary>Edit task</summary><form class="inline-tool-form" data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks/<%= task.id %>/update" method="post"><input name="title" value="<%= task.title %>" required><button class="button secondary" type="submit">Save</button></form></details><details class="inline-edit"><summary>Delegate task</summary><form class="inline-tool-form" data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks/<%= task.id %>/delegate" method="post"><select name="userId"><% group.members.forEach(memberId => { const delegateUser = users.find(userRecord => userRecord.id === memberId) || { name: 'Member' }; %><option value="<%= memberId %>" <%= task.claimedBy === memberId ? 'selected' : '' %>><%= delegateUser.name %></option><% }) %></select><button class="button secondary" type="submit">Delegate</button></form></details><form data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/tasks/<%= task.id %>/delete" method="post"><button class="menu-action danger" type="submit">Delete task</button></form><% } %></div></details><% } %></span></article>
          <% }) %>
        </div>
      </section>
      <details class="breakout-tools-modal"><summary class="rail-panel breakout-tools-trigger"><span><i data-lucide="settings-2"></i> Group tools</span><i data-lucide="chevron-down"></i></summary><section class="rail-panel breakout-tools-panel"><div class="panel-heading"><div><p class="eyebrow">PEOPLE</p><h2>Members</h2></div><span class="muted"><%= group.members.length %>/<%= group.limit %></span></div><div class="member-list clean-members"><% group.members.forEach(memberId => { const memberUser = users.find(userRecord => userRecord.id === memberId) || { name: 'Member', username: 'member' }; %><div class="member-row"><span class="avatar"><%= memberUser.name[0] %></span><div><strong><%= memberUser.name %></strong><small>@<%= memberUser.username %></small></div><span class="role-label"><%= group.roles?.[memberId] || 'Member' %></span></div><% }) %></div><% if (groupAdmin) { %><form class="inline-tool-form" action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/members" method="post"><input name="username" placeholder="Add by username" required><button class="button secondary" type="submit">Add person</button></form><form class="inline-tool-form" action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/settings" method="post"><label>Capacity<input name="limit" type="number" min="<%= Math.max(2, group.members.length) %>" max="50" value="<%= group.limit %>" required></label><button class="button secondary" type="submit">Save capacity</button></form><p class="muted invite-link"><i data-lucide="link-2"></i> Share <a href="/b/<%= group.shareCode %>">/b/<%= group.shareCode %></a></p><% } %></section></details>
    </aside>
  </div>
</section>
