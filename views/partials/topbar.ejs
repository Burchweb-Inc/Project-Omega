<% const userNotifications=typeof notifications==='undefined' ? (user.notifications || []) : notifications; const
    unreadNotifications=userNotifications.filter(notification=> !notification.read); %>
    <header class="topbar"><button class="mobile-menu icon-button" aria-label="Open navigation"><i
                data-lucide="menu"></i></button>
        <div class="breadcrumbs"><a href="/dashboard">My desk</a><i data-lucide="chevron-right"></i><strong>
                <%= locals.selectedOrg?.name || ({ dashboard: 'Overview' , todo: 'Personal Todo' ,
                    calendar: 'Academic calendar' , groups: 'Breakout groups' }[page] || 'Study space' ) %>
            </strong></div>
        <div class="top-actions"><a href="/about" style="text-decoration:none;"><span class="offline-status"><i data-lucide="hand-heart"></i> Support Us</span></a>
            <details class="notification-menu">
                <summary class="icon-button" aria-label="Notifications"><i data-lucide="bell"></i>
                    <% if (unreadNotifications.length) { %><span class="notification-count">
                            <%= unreadNotifications.length %>
                        </span>
                        <% } %>
                </summary>
                <div class="notification-popover">
                    <div class="notification-heading"><strong>Notifications</strong>
                        <% if (unreadNotifications.length) { %>
                            <form data-live-form action="/notifications/read-all" method="post"><button
                                    class="text-button" type="submit">Mark all read</button></form>
                            <% } %>
                    </div>
                    <% if (userNotifications.length) { userNotifications.slice(0, 8).forEach(notification=> { %><div
                            class="notification-item <%= notification.read ? 'is-read' : 'unread' %>"
                            data-notification-id="<%= notification.id %>">
                            <div><strong>
                                    <%= notification.title %>
                                </strong>
                                <p>
                                    <%= notification.message %>
                                </p>
                                <% if (notification.href && notification.actionLabel) { %><a class="text-button"
                                        href="<%= notification.href %>">
                                        <%= notification.actionLabel %>
                                    </a>
                                    <% } %><small>
                                            <%= new Date(notification.createdAt).toLocaleString() %>
                                        </small>
                            </div>
                            <div class="notification-actions">
                                <% if (!notification.read) { %>
                                    <form data-live-form action="/notifications/<%= notification.id %>/read"
                                        method="post"><button class="icon-button" type="submit"
                                            aria-label="Mark notification read"><i data-lucide="check"></i></button>
                                    </form>
                                    <% } %>
                                        <form data-live-form action="/notifications/<%= notification.id %>/delete"
                                            method="post"><button class="icon-button notification-delete-button"
                                                type="submit" aria-label="Delete notification"><i
                                                    data-lucide="trash-2"></i></button></form>
                            </div>
                        </div>
                        <% }) } else { %>
                            <p class="notification-empty">You are all caught up.</p>
                            <% } %>
                </div>
            </details><span class="avatar small">
                <%= user.name[0] %>
            </span>
        </div>
    </header>
    <% if (user.moderationStatus==='active' && userNotifications.some(notification=> notification.type === 'warning' &&
        !notification.read)) { %><div class="conduct-banner" role="alert"><i data-lucide="triangle-alert"></i><span>You
                have a conduct warning. Open Notifications to review it.</span></div>
        <% } %>