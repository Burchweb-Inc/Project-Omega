<details class="comment-menu"><summary class="icon-button" aria-label="More comment actions"><i data-lucide="ellipsis"></i></summary><div class="comment-menu-popover"><% if (comment.userId === user.id || groupAdmin) { %><button class="menu-action" type="button" data-comment-edit-open><i data-lucide="pencil"></i> Edit comment</button><% } %><form data-live-form action="/org/<%= selectedOrg.id %>/content-reports" method="post"><input type="hidden" name="contentId" value="<%= comment.id %>"><button class="menu-action" type="submit">Report comment</button></form><% if (comment.userId === user.id || groupAdmin) { %><form data-live-form action="/org/<%= selectedOrg.id %>/breakout/<%= group.id %>/comments/<%= comment.id %>/delete" method="post"><button class="menu-action danger" type="submit">Delete comment</button></form><% } %></div></details>
