<section class="content-wrap narrow-page"><a class="back-link" href="/org/<%= selectedOrg.id %>/course/<%= course.id %>"><i data-lucide="arrow-left"></i> <%= course.name %></a><div class="page-heading compact-heading"><div><p class="kicker"><%= course.code %></p><h1>Add to the plan</h1><p class="muted">Use events for moments, tasks for work to complete.</p></div></div><form class="page-form" action="/org/<%= selectedOrg.id %>/courses/<%= course.id %>/items" method="post"><label>Title<input name="title" placeholder="Read chapter 4" required></label><label>Type<select name="type"><option>Homework</option><option>Upcoming test</option><option>Event</option><option>Project</option></select></label><label>Date<input name="due" type="date"></label><div class="form-actions"><a class="button secondary" href="/org/<%= selectedOrg.id %>/course/<%= course.id %>">Cancel</a><button class="button primary">Add to course <i data-lucide="arrow-up-right"></i></button></div></form></section>