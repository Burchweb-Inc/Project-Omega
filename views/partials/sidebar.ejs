<aside class="sidebar" aria-label="Primary navigation">
  <div class="sidebar-head">
    <a href="/dashboard" class="wordmark sidebar-logo" aria-label="LockIn dashboard"><img src="/media/logo.png" alt="LockIn"></a>
    <button class="lui-icon-button sidebar-toggle" type="button" data-sidebar-toggle aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar"><i data-lucide="panel-left-close"></i></button>
  </div>
  <nav class="nav-groups">
    <div class="nav-label">MY DESK</div>
    <a class="nav-link <%= page === 'dashboard' ? 'selected' : '' %>" href="/dashboard"><i
        data-lucide="layout-dashboard"></i><span>Overview</span></a>
    <a class="nav-link <%= page === 'todo' ? 'selected' : '' %>" href="/todo?filter=pending"><i
        data-lucide="check-square-2"></i><span>Personal Todo</span><strong class="nav-count" data-live-todo-count>
        <%= (user.tasks || []).filter(task=> !task.done).length %>
      </strong></a>
    <a class="nav-link <%= page === 'calendar' ? 'selected' : '' %>" href="/calendar"><i
          data-lucide="calendar-days"></i><span>Academic calendar</span></a>
    <div class="nav-label space-label">YOUR GROUPS</div>
    <a class="nav-link <%= page === 'groups' ? 'selected' : '' %>" href="/groups"><i
        data-lucide="users-round"></i><span>All groups</span></a>
    <% if (user.isSiteAdmin) { %><a class="nav-link site-admin-link <%= page === 'site-admin' ? 'selected' : '' %>"
        href="/site-admin"><i data-lucide="shield-check"></i><span>Site Admin</span></a>
      <% } %>
        <% orgs.filter(org=> org.members.some(member => member.userId === user.id)).slice(-3).forEach(org => { %><a
            class="space-link" href="/group/<%= org.slug || org.id %>"><span class="space-dot"
              style="background:<%= org.courses[0]?.color || '#e56b4f' %>"></span><span>
              <%= org.name %>
            </span></a>
          <% }) %>
            <a class="new-space" href="/group/new"><i data-lucide="plus"></i><span>New group</span></a>
  </nav>
  <div class="sidebar-foot">
    <small class="sidebar-version" title="Current server build ID" aria-label="Current server build ID <%= buildInfo.id %>">build <%= buildInfo.id %></small>
    <div class="sidebar-foot-body">
      <% if (process.env.APP_MODE==='beta' ) { %><a class="beta-badge" href="/beta" title="Learn about beta">BETA</a>
        <% } %>
      <div class="user-chip"><span class="avatar">
          <%= user.name[0] %>
        </span>
        <div><strong>
            <%= user.name %>
          </strong><small>@<%= user.username %></small></div>
      </div>
      <details class="account-menu">
        <summary class="lui-icon-button" aria-label="Account menu" title="Account menu"><i data-lucide="ellipsis"></i>
        </summary>
        <div class="account-menu-popover"><a class="lui-menu-action" href="/settings"><i data-lucide="settings"></i>
            Account settings</a>
          <% if (user.settings?.betaTools) { %><details><summary class="lui-menu-action"><i data-lucide="flask-conical"></i> Beta access</summary><a class="lui-menu-action" href="/beta-tests/3drender"><i data-lucide="box"></i> 3D Render test</a></details><% } %>
          <button class="lui-menu-action" type="button" data-debug-open><i data-lucide="bug"></i>
            Debug</button>
          <form action="/logout" method="post"><button class="lui-menu-action" type="submit"><i data-lucide="log-out"></i>
              Sign out</button></form>
        </div>
      </details>
    </div>
  </div>
</aside>