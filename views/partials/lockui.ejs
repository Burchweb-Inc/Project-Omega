<%
  const lockuiTimezones = ['America/New_York', 'America/Los_Angeles', 'Europe/London'];
  const includeSnippet = (partial, locals) => '<' + '%' + '- include(\'' + partial + '\', { ' + locals + ' }) ' + '%' + '>';
  const lockuiSnippets = {
    buttons: '<button class="lui-button lui-button-primary" type="button">Create task</button>\n<button class="lui-button lui-button-secondary" type="button">Cancel</button>\n<button class="lui-button lui-button-danger" type="button">Delete</button>\n<button class="lui-icon-button" type="button" aria-label="More actions"><i data-lucide="ellipsis"></i></button>',
    fields: '<label class="lui-field">Task title\n  <input class="lui-input" value="Read chapter 4">\n</label>\n<label class="lui-field">Course\n  <select class="lui-select"><option>Biology 101</option><option>Modern History</option></select>\n</label>\n<label class="lui-field lui-grid-wide">Notes\n  <textarea class="lui-textarea" placeholder="Add notes"></textarea>\n</label>\n<label class="lui-check"><input type="checkbox" checked> Keep this private</label>',
    task: '<article class="lui-task">\n  <button class="lui-check" type="button" aria-label="Mark task complete"><i data-lucide="circle"></i></button>\n  <div><strong>Read chapter 4</strong><small>Biology 101 · Due Oct 31</small></div>\n  <span class="lui-status">Normal</span>\n</article>',
    menu: '<details class="task-menu">\n  <summary class="lui-icon-button" aria-label="More actions"><i data-lucide="ellipsis"></i></summary>\n  <div class="task-menu-popover lui-menu-panel">\n    <button class="lui-menu-action" type="button">Edit task</button>\n    <button class="lui-menu-action lui-menu-action-danger" type="button">Delete task</button>\n  </div>\n</details>',
    accountMenu: '<details class="account-menu">\n  <summary class="lui-icon-button" aria-label="Account menu"><i data-lucide="ellipsis"></i></summary>\n  <div class="account-menu-popover lui-menu-panel">\n    <button class="lui-menu-action" type="button">Account settings</button>\n    <button class="lui-menu-action" type="button">Sign out</button>\n  </div>\n</details>',
    groupMenu: '<details class="group-menu">\n  <summary class="lui-icon-button" aria-label="Group actions"><i data-lucide="ellipsis"></i></summary>\n  <div class="group-menu-popover lui-menu-panel">\n    <button class="lui-menu-action" type="button">Edit group</button>\n    <button class="lui-menu-action lui-menu-action-danger" type="button">Delete group</button>\n  </div>\n</details>',
    commentMenu: '<details class="comment-menu">\n  <summary class="lui-icon-button" aria-label="Comment actions"><i data-lucide="ellipsis"></i></summary>\n  <div class="comment-menu-popover lui-menu-panel">\n    <button class="lui-menu-action" type="button">Edit comment</button>\n    <button class="lui-menu-action lui-menu-action-danger" type="button">Delete comment</button>\n  </div>\n</details>',
    notifications: '<details class="notification-menu lui-menu">\n  <summary class="lui-icon-button lui-menu-trigger" aria-label="Notifications"><i data-lucide="bell"></i></summary>\n  <div class="notification-popover lui-menu-panel">\n    <div class="notification-heading"><strong>Notifications</strong><button class="lui-link" type="button">Mark all read</button></div>\n    <article class="notification-item unread"><div><strong>Task due tomorrow</strong><p>Read chapter 4 in Biology 101.</p><small>Just now</small></div></article>\n    <article class="notification-item is-read"><div><strong>New group comment</strong><p>Alex replied to your question.</p><small>Yesterday</small></div></article>\n  </div>\n</details>',
    comment: '<article class="lui-comment">\n  <span class="lui-avatar lui-avatar-sm">AM</span>\n  <div><strong>Alex Morgan</strong><p>I added the reading notes.</p></div>\n  <button class="lui-icon-button" type="button" aria-label="Comment actions"><i data-lucide="ellipsis"></i></button>\n</article>',
    feedback: '<div class="lui-alert"><i data-lucide="info"></i><span>Details are checked before they enter the shared space.</span></div>\n<div class="lui-alert lui-alert-success" role="status"><i data-lucide="circle-check"></i><span>Your changes were saved.</span></div>\n<div class="lui-alert lui-alert-warning"><i data-lucide="triangle-alert"></i><span>This task needs a date.</span></div>\n<div class="lui-alert lui-alert-danger" role="alert"><i data-lucide="circle-alert"></i><span>We could not complete that action.</span></div>',
    layout: '<article class="lui-card">\n  <h3>Course progress</h3><p>8 of 12 tasks complete</p>\n  <div class="lui-progress" role="progressbar" aria-label="Course progress" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"><span style="width: 68%"></span></div>\n</article>\n<article class="lui-panel lui-stack">\n  <h3>Group work</h3><p>Keep related controls together in a panel.</p><hr class="lui-divider">\n  <div class="lui-cluster"><span class="lui-avatar">AM</span><span class="lui-kbd">Cmd K</span><span class="lui-status lui-status-success">Ready</span></div>\n</article>',
    data: '<span class="lui-badge">4 items</span>\n<span class="lui-status lui-status-success">Complete</span>\n<span class="lui-status lui-status-warning">Needs review</span>\n<span class="lui-status lui-status-danger">Blocked</span>\n<span class="lui-avatar">AM</span>',
    table: '<div class="lui-table-wrap"><table class="lui-table">\n  <thead><tr><th>Task</th><th>Owner</th><th>Status</th></tr></thead>\n  <tbody>\n    <tr><td>Research outline</td><td>Alex Morgan</td><td><span class="lui-status lui-status-success">Complete</span></td></tr>\n    <tr><td>Group presentation</td><td>Jamie Lee</td><td><span class="lui-status lui-status-warning">In review</span></td></tr>\n  </tbody>\n</table></div>',
    empty: '<div class="lui-empty">\n  <i data-lucide="inbox"></i><strong>No tasks yet</strong>\n  <button class="lui-button lui-button-primary" type="button">Add task</button>\n</div>',
    timezone: includeSnippet('mini/timezone-select', "id: 'group-timezone-picker', name: 'timezone', value: adminOrg.timezone, timezones"),
    userSearch: includeSnippet('mini/user-search', "id: 'member-search', label: 'Add a member', name: 'username', placeholder: 'Search members', groupId: selectedOrg.id"),
    copyAction: includeSnippet('mini/copy-task-action', 'item, selectedOrg'),
    copyModal: includeSnippet('mini/copy-task-modal', 'copyDestinations'),
    taskSync: includeSnippet('mini/task-sync-modal', 'user, integrationStatus, taskSyncConfigured, taskSyncMissingConfig, googleTasksConfigured, googleTasksConnected, appleRemindersConnected, appleRemindersUsername')
  };
%>
<main class="lui-page lui-gallery" aria-labelledby="lockui-title">
  <div class="lui-wrap">
    <header class="lui-gallery-header">
      <a class="wordmark" href="/" aria-label="LockIn home"><img src="/media/logo-text.png" alt="LockIn"></a>
      <a class="lui-link" href="/">Back to LockIn</a>
      <h1 id="lockui-title">LockUI</h1>
      <p class="lui-muted">Reusable interface components used across LockIn. Hover or focus a sample to copy its markup or expand the code.</p>
    </header>

    <section class="lui-section" aria-labelledby="layout-section">
      <div class="lui-section-title"><h2 id="layout-section">Cards and progress</h2></div>
      <article class="lui-component" data-lui-component>
        <div class="lui-component-heading"><h3>Surface and progress</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy card and progress markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand card and progress code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
        <div class="lui-component-preview lui-grid"><article class="lui-card"><h3>Course progress</h3><p>8 of 12 tasks complete</p><div class="lui-progress" role="progressbar" aria-label="Course progress" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"><span style="width: 68%"></span></div></article><article class="lui-panel lui-stack"><h3>Group work</h3><p>Keep related controls together in a panel.</p><hr class="lui-divider"><div class="lui-cluster"><span class="lui-avatar">AM</span><span class="lui-kbd">Cmd K</span><span class="lui-status lui-status-success">Ready</span></div></article></div>
        <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.layout %></code></pre></details>
      </article>
    </section>

    <section class="lui-section" aria-labelledby="buttons-section">
      <div class="lui-section-title"><h2 id="buttons-section">Buttons and fields</h2></div>
      <div class="lui-grid">
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Actions</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy button markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand button code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-cluster"><button class="lui-button lui-button-primary" type="button">Create task</button><button class="lui-button lui-button-secondary" type="button">Cancel</button><button class="lui-button lui-button-danger" type="button">Delete</button><button class="lui-icon-button" type="button" aria-label="More actions"><i data-lucide="ellipsis"></i></button></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.buttons %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Form controls</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy form markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand form code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-grid"><label class="lui-field">Task title<input class="lui-input" value="Read chapter 4"></label><label class="lui-field">Course<select class="lui-select"><option>Biology 101</option><option>Modern History</option></select></label><label class="lui-field lui-grid-wide">Notes<textarea class="lui-textarea" placeholder="Add notes"></textarea></label><label class="lui-check"><input type="checkbox" checked> Keep this private</label></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.fields %></code></pre></details>
        </article>
      </div>
    </section>

    <section class="lui-section" aria-labelledby="work-section">
      <div class="lui-section-title"><h2 id="work-section">Tasks and comments</h2></div>
      <div class="lui-grid">
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Task row</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy task markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand task code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview"><article class="lui-task"><button class="lui-check" type="button" aria-label="Mark task complete" data-lui-task-toggle><i data-lucide="circle"></i></button><div><strong>Read chapter 4</strong><small>Biology 101 · Due Oct 31</small></div><span class="lui-status">Normal</span></article></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.task %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Comment</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy comment markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand comment code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview"><article class="lui-comment"><span class="lui-avatar lui-avatar-sm">AM</span><div><strong>Alex Morgan</strong><p>I added the reading notes.</p></div><button class="lui-icon-button" type="button" aria-label="Comment actions"><i data-lucide="ellipsis"></i></button></article></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.comment %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Badges and status</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy status markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand status code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-cluster"><span class="lui-badge">4 items</span><span class="lui-status lui-status-success">Complete</span><span class="lui-status lui-status-warning">Needs review</span><span class="lui-status lui-status-danger">Blocked</span><span class="lui-avatar">AM</span></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.data %></code></pre></details>
        </article>
      </div>
    </section>

    <section class="lui-section" aria-labelledby="menus-section">
      <div class="lui-section-title"><h2 id="menus-section">Menus and notifications</h2></div>
      <div class="lui-grid">
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Action menu</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy action menu markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand action menu code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="task-menu"><summary class="lui-icon-button" aria-label="More task actions"><i data-lucide="ellipsis"></i></summary><div class="task-menu-popover"><button class="lui-menu-action" type="button"><i data-lucide="pencil"></i>Edit task</button><button class="lui-menu-action lui-menu-action-danger" type="button"><i data-lucide="trash-2"></i>Delete task</button></div></details></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.menu %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Notification menu</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy notification markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand notification code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="notification-menu"><summary class="lui-icon-button" aria-label="Notifications"><i data-lucide="bell"></i><span class="notification-count">2</span></summary><div class="notification-popover"><div class="notification-heading"><strong>Notifications</strong><button class="lui-link" type="button">Mark all read</button></div><article class="notification-item unread"><div><strong>Task due tomorrow</strong><p>Read chapter 4 in Biology 101.</p><small>Just now</small></div></article><article class="notification-item is-read"><div><strong>New group comment</strong><p>Alex replied to your question.</p><small>Yesterday</small></div></article></div></details></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.notifications %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Tabs</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy tabs markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand tabs code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <nav class="lui-component-preview lui-tabs" role="tablist" aria-label="Demo tabs"><button class="lui-tab" role="tab" data-lui-tab aria-selected="true" type="button">Overview</button><button class="lui-tab" role="tab" data-lui-tab aria-selected="false" type="button">Activity</button><button class="lui-tab" role="tab" data-lui-tab aria-selected="false" type="button">People</button></nav>
          <details class="lui-source"><summary>Markup</summary><pre><code>&lt;nav class="lui-tabs" role="tablist" aria-label="Views"&gt;
  &lt;button class="lui-tab" role="tab" aria-selected="true" type="button"&gt;Overview&lt;/button&gt;
  &lt;button class="lui-tab" role="tab" aria-selected="false" type="button"&gt;Activity&lt;/button&gt;
&lt;/nav&gt;</code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Account menu</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy account menu markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand account menu code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="account-menu"><summary class="lui-icon-button" aria-label="Account menu"><i data-lucide="ellipsis"></i></summary><div class="account-menu-popover"><button class="lui-menu-action" type="button">Account settings</button><button class="lui-menu-action" type="button">Sign out</button></div></details><span class="lui-muted">Account actions</span></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.accountMenu %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Group menu</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy group menu markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand group menu code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="group-menu"><summary class="lui-icon-button" aria-label="Group actions"><i data-lucide="ellipsis"></i></summary><div class="group-menu-popover"><button class="lui-menu-action" type="button">Edit group</button><button class="lui-menu-action lui-menu-action-danger" type="button">Delete group</button></div></details><span class="lui-muted">Group actions</span></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.groupMenu %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Comment action menu</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy comment menu markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand comment menu code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="comment-menu"><summary class="lui-icon-button" aria-label="Comment actions"><i data-lucide="ellipsis"></i></summary><div class="comment-menu-popover"><button class="lui-menu-action" type="button">Edit comment</button><button class="lui-menu-action lui-menu-action-danger" type="button">Delete comment</button></div></details><span class="lui-muted">Edit or remove a comment</span></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.commentMenu %></code></pre></details>
        </article>
      </div>
    </section>

    <section class="lui-section" aria-labelledby="states-section">
      <div class="lui-section-title"><h2 id="states-section">Panels and feedback</h2></div>
      <div class="lui-grid">
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Feedback</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy feedback markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand feedback code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-stack"><div class="lui-alert"><i data-lucide="info"></i><span>Details are checked before they enter the shared space.</span></div><div class="lui-alert lui-alert-success" role="status"><i data-lucide="circle-check"></i><span>Your changes were saved.</span></div><div class="lui-alert lui-alert-warning"><i data-lucide="triangle-alert"></i><span>This task needs a date.</span></div><div class="lui-alert lui-alert-danger" role="alert"><i data-lucide="circle-alert"></i><span>We could not complete that action.</span></div></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.feedback %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Table</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy table markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand table code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview"><div class="lui-table-wrap"><table class="lui-table"><thead><tr><th>Task</th><th>Owner</th><th>Status</th></tr></thead><tbody><tr><td>Research outline</td><td>Alex Morgan</td><td><span class="lui-status lui-status-success">Complete</span></td></tr><tr><td>Group presentation</td><td>Jamie Lee</td><td><span class="lui-status lui-status-warning">In review</span></td></tr></tbody></table></div></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.table %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Empty state</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy empty state markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand empty state code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview"><div class="lui-empty"><i data-lucide="inbox"></i><strong>No tasks yet</strong><span>Add a task to get started.</span><button class="lui-button lui-button-primary" type="button">Add task</button></div></div>
          <details class="lui-source"><summary>Markup</summary><pre><code><%= lockuiSnippets.empty %></code></pre></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Dialog</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy markup" aria-label="Copy dialog markup"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand dialog code" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-cluster"><button class="lui-button lui-button-secondary" type="button" data-lui-dialog-open="lui-demo-dialog">Open dialog</button><dialog class="lui-dialog" id="lui-demo-dialog" data-lui-demo-dialog><form method="dialog"><header><h2>Confirm action</h2><button class="lui-icon-button" type="submit" aria-label="Close dialog"><i data-lucide="x"></i></button></header><p>This dialog is a working local demo.</p><button class="lui-button lui-button-primary" type="submit">Done</button></form></dialog></div>
          <details class="lui-source"><summary>Markup</summary><pre><code>&lt;dialog class="lui-dialog"&gt;
  &lt;form method="dialog"&gt;
    &lt;header&gt;&lt;h2&gt;Confirm action&lt;/h2&gt;&lt;/header&gt;
    &lt;button class="lui-button lui-button-primary"&gt;Done&lt;/button&gt;
  &lt;/form&gt;
&lt;/dialog&gt;</code></pre></details>
        </article>
      </div>
    </section>

    <section class="lui-section" aria-labelledby="partials-section">
      <div class="lui-section-title"><h2 id="partials-section">Mini partials</h2></div>
      <p class="lui-muted">EJS includes used by the app. Copy the include call and pass the locals shown in each example.</p>
      <div class="lui-grid">
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Time-zone picker</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy include" aria-label="Copy time-zone include"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand time-zone usage" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-mini-preview"><label class="lui-field">Time zone<div class="timezone-picker" data-timezone-picker><input type="hidden" value="America/New_York" data-timezone-value><button class="lui-menu-trigger timezone-picker-trigger" type="button" data-timezone-trigger aria-haspopup="listbox" aria-expanded="false"><span data-timezone-selected>America/New_York</span><i data-lucide="chevron-down"></i></button><div class="timezone-picker-panel" data-timezone-panel hidden><label class="timezone-picker-search"><i data-lucide="search"></i><input type="search" data-timezone-search placeholder="Search city or time zone" aria-label="Search time zones"></label><div class="timezone-picker-options" role="listbox" aria-label="Time zones"><% lockuiTimezones.forEach((zone, index) => { %><button class="lui-menu-action timezone-picker-option" type="button" role="option" tabindex="<%= index === 0 ? '0' : '-1' %>" aria-selected="<%= index === 0 ? 'true' : 'false' %>" data-timezone-option="<%= zone %>" data-search-value="<%= zone.replace(/[_/]/g, ' ') %>"><span><%= zone.replace(/_/g, ' ') %></span></button><% }) %><p class="timezone-picker-empty" data-timezone-empty hidden>No matches.</p></div><p class="timezone-picker-count" data-timezone-count>3 time zones</p></div></div></label></div>
          <details class="lui-source"><summary>Include usage</summary><pre><code><%= lockuiSnippets.timezone %></code></pre><p class="lui-help">The parent route must provide <code>adminOrg.timezone</code> and <code>timezones</code>.</p></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Member search</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy include" aria-label="Copy member-search include"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand member-search usage" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-mini-preview"><label class="lui-field">Add a member<div class="lui-search-demo"><input class="lui-input" type="text" placeholder="Search members" role="combobox" aria-haspopup="listbox" aria-autocomplete="list" aria-expanded="false" aria-controls="lui-demo-member-results" data-lui-search-demo><div class="user-search-results" id="lui-demo-member-results" data-lui-search-results role="listbox" aria-label="Sample members" hidden><button class="lui-menu-action" type="button" role="option" aria-selected="false">Alex Morgan <small>@alexm</small></button><button class="lui-menu-action" type="button" role="option" aria-selected="false">Jamie Lee <small>@jamiel</small></button></div></div></label></div>
          <details class="lui-source"><summary>Include usage</summary><pre><code><%= lockuiSnippets.userSearch %></code></pre><p class="lui-help">Requires a signed-in user and a group ID for scoped results.</p></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Copy-task action</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy include" aria-label="Copy task-action include"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand task-action usage" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-menu-preview"><details class="task-menu"><summary class="lui-icon-button" aria-label="Task actions"><i data-lucide="ellipsis"></i></summary><div class="task-menu-popover"><button class="lui-menu-action" type="button" data-lui-demo-copy-task><i data-lucide="copy"></i>Copy task</button></div></details><span class="lui-muted">Open the menu to see the action.</span></div>
          <details class="lui-source"><summary>Include usage</summary><pre><code><%= lockuiSnippets.copyAction %></code></pre><p class="lui-help">Pass the current <code>item</code> and <code>selectedOrg</code>; the action opens the copy-task dialog.</p></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Copy-task modal</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy include" aria-label="Copy copy-task-modal include"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand copy-task-modal usage" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-cluster"><button class="lui-button lui-button-secondary" type="button" data-lui-open-modal="copy-task-demo">Open modal demo</button><dialog class="lui-dialog" id="copy-task-demo" data-lui-demo-dialog><form method="dialog"><header><h2>Copy task</h2><button class="lui-icon-button" type="submit" aria-label="Close"><i data-lucide="x"></i></button></header><p>Choose a group, then a course. This preview does not save anything.</p><label class="lui-field">Destination<select class="lui-select"><option>Sample study group</option></select></label><div class="lui-cluster"><button class="lui-button lui-button-primary" type="submit">Done</button><button class="lui-button lui-button-quiet" type="submit">Cancel</button></div></form></dialog></div>
          <details class="lui-source"><summary>Include usage</summary><pre><code><%= lockuiSnippets.copyModal %></code></pre><p class="lui-help">Pass <code>copyDestinations</code> with the destination groups and their courses.</p></details>
        </article>
        <article class="lui-component" data-lui-component>
          <div class="lui-component-heading"><h3>Task-sync modal</h3><div class="lui-component-tools"><button class="lui-icon-button" type="button" data-lui-copy data-tooltip="Copy include" aria-label="Copy task-sync-modal include"><i data-lucide="copy"></i></button><button class="lui-icon-button" type="button" data-lui-expand data-tooltip="Expand code" aria-label="Expand task-sync-modal usage" aria-expanded="false"><i data-lucide="code-2"></i></button></div></div>
          <div class="lui-component-preview lui-cluster"><button class="lui-button lui-button-secondary" type="button" data-lui-open-modal="task-sync-demo">Open modal demo</button><dialog class="lui-dialog" id="task-sync-demo" data-lui-demo-dialog><form method="dialog"><header><h2>Task sync</h2><button class="lui-icon-button" type="submit" aria-label="Close"><i data-lucide="x"></i></button></header><p>Connect a task provider and choose a sync schedule.</p><label class="lui-field">Automatic sync<select class="lui-select"><option>Only manual</option><option>Every hour</option></select></label><button class="lui-button lui-button-primary" type="submit">Done</button></form></dialog></div>
          <details class="lui-source"><summary>Include usage</summary><pre><code><%= lockuiSnippets.taskSync %></code></pre><p class="lui-help">Requires the account settings, integration status, and provider connection locals used by Todo.</p></details>
        </article>
      </div>
    </section>

    <div class="lui-gallery-status" role="status" aria-live="polite" data-lui-status></div>
  </div>
</main>
