<section class="content-wrap course-page" data-course-live data-org-id="<%= selectedOrg.id %>" data-course-id="<%= course.id %>" data-user-id="<%= user.id %>" data-is-admin="<%= user.isSiteAdmin || member?.role === 'admin' || member?.role === 'moderator' %>" data-date-timezone="<%= courseTimezone || 'UTC' %>" data-date-locale="<%= courseDateLocale || 'en-US' %>" data-can-edit="<%= canEdit(member) %>">
<a class="back-link" href="/org/<%= selectedOrg.id %>">
<i data-lucide="arrow-left">
</i> <%= selectedOrg.name %>
</a>
<div class="page-heading hero-heading">
<div>
<div class="course-kicker">
<span class="course-color" style="background:<%= course.color %>">
</span>
<%= course.code %>
</div>
<h1>
<%= course.name %>
</h1>
<p class="lead">A focused feed for homework, tests, events, and the questions between them.</p>
</div>
<% if (canEdit(member)) { %>
<button class="button primary" type="button" data-inline-create>
<i data-lucide="plus">
</i> Create event</button>
<% } %>
</div>
<div class="course-tabs" role="tablist">
<a class="active" href="#feed" data-course-tab="feed">Feed</a>
<a href="#board" data-course-tab="board">Project board</a>
<a href="#resources" data-course-tab="resources">Resources</a>
</div>
<% if (!user.settings?.pushNotifications?.enabled) { %><aside class="settings-tip" data-push-tip><i data-lucide="bell-ring"></i><div><strong>A useful little alert</strong><p>Turn on Push Notifications to hear about breakout comments and tasks without keeping this tab in front.</p><a class="text-button" href="/settings#push-notifications">Choose what you hear</a></div><button class="icon-button settings-tip-dismiss" type="button" data-push-tip-dismiss aria-label="Dismiss push notification tip" title="Dismiss"><i data-lucide="x"></i></button></aside><% } %>
<div class="course-layout">
<section id="feed" class="feed-panel course-view active" data-course-view="feed">
<div class="panel-heading">
<div>
<h2>What the class knows</h2>
</div>
<span class="filter-label">
<i data-lucide="radio">
</i> Live</span>
</div>
<% if (canEdit(member)) { %>
<form class="inline-create-form page-form hidden" data-live-form action="/org/<%= selectedOrg.id %>/courses/<%= course.id %>/items" method="post">
<div class="inline-create-fields">
<label>Title<input name="title" placeholder="Read chapter 4" required>
</label>
<label>Type<select name="type">
<option>Homework</option>
<option>Upcoming test</option>
<option>Event</option>
<option>Project</option>
</select>
</label>
<label>Date<input name="due" type="date">
</label>
<button class="button primary" type="submit">Add to feed</button>
</div>
<a class="text-button" href="/org/<%= selectedOrg.id %>/course/<%= course.id %>/items/new">Advanced create/edit <i data-lucide="arrow-up-right">
</i>
</a>
</form>
<% } %>
<div class="course-feed-tools"><label class="course-feed-search"><i data-lucide="search"></i><input type="search" data-course-search placeholder="Search the class feed" aria-label="Search the class feed"></label><select data-course-filter aria-label="Filter the class feed"><option value="all">All items</option><option value="active">Active</option><option value="past">Past</option><option value="homework">Homework</option><option value="tests">Tests</option><option value="projects">Projects</option></select></div>
<div class="course-feed-folders" data-feed-list>
<% ['current', 'past'].forEach(folder => { %><section class="course-feed-folder" data-course-folder="<%= folder %>"><div class="course-feed-folder-heading"><h3><%= folder === 'past' ? 'Past' : 'Current' %></h3><span data-course-folder-count="<%= folder %>"></span></div><div class="feed-list">
<% course.items.filter(item => folder === 'past' ? item.past : !item.past).forEach(item => { %>
<article class="feed-card feed-item" data-item-id="<%= item.id %>" data-position="<%= item.position || 0 %>" data-past="<%= item.past ? 'true' : 'false' %>" data-type="<%= item.type %>">
<div class="feed-card-head">
<span class="category-dot category-<%= item.type.toLowerCase().replace(/[^a-z]/g, '-') %>">
</span>
<div>
<span class="feed-source">
<%= item.type %> · <%= formatCourseDate(item.due, courseTimezone, courseDateLocale) %>
</span>
<h3 data-item-title>
<%- renderLinkedText(item.title, item.links) %>
</h3>
<% if (item.details) { %><p class="task-details"><%- renderLinkedText(item.details, item.links) %></p><% } %>
</div>
<span class="confidence">
<i data-lucide="shield-check">
</i> <span data-verify-count>
<%= (item.verifiedBy || []).length %>
</span>
</span>
<button class="icon-button course-drag-handle" type="button" aria-label="Move <%= item.title %>"><i data-lucide="grip-vertical"></i></button>
</div>
<div class="feed-card-foot">
<div class="feed-card-actions">
<form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/verify" method="post">
<button class="text-button" type="submit">
<i data-lucide="badge-check">
</i> Confirm details</button>
</form>
<form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/todo" method="post">
<button class="text-button" type="submit">
<i data-lucide="inbox">
</i> Add to My Todo</button>
</form>
<form data-live-form action="/org/<%= selectedOrg.id %>/content-reports" method="post">
<input type="hidden" name="contentId" value="<%= item.id %>">
<input type="hidden" name="reason" value="Inappropriate content">
<button class="text-button" type="submit"><i data-lucide="flag"></i> Report</button>
</form>
<% if (item.type === 'Project') { %>
<a class="text-button breakout-action" href="/org/<%= selectedOrg.id %>/course/<%= course.id %>/task/<%= `${item.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || item.id}-${item.id.slice(-8)}` %>/breakout-groups">
<i data-lucide="users-round">
</i> Breakout Groups
</a>
<% } %>
<form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/downvote" method="post">
<button class="text-button" type="submit">
<i data-lucide="thumbs-down">
</i><% if (user.isSiteAdmin || member?.role === 'admin' || member?.role === 'moderator') { %> <span data-downvote-count><%= (item.downvotedBy || []).length %></span><% } %>
</button>
</form>
<% if (item.createdBy === user.id || member?.role === 'admin' || member?.role === 'moderator' || (selectedOrg.groups || []).some(group => group.itemId === item.id && (group.createdBy === user.id || group.roles?.[user.id] === 'Organizer'))) { %>
<details class="item-edit-details">
<summary class="text-button"><i data-lucide="pencil"></i> Edit</summary>
<form class="inline-tool-form item-edit-form" data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/update" method="post">
<label class="item-title-field">Title<input name="title" value="<%= item.title %>" required></label>
<label>Details<textarea name="details" rows="5" placeholder="Details"><%= item.details || '' %></textarea></label>
<div class="link-draft-previews" data-link-draft-previews hidden></div>
<label>Type<select name="type"><option <%= item.type === 'Homework' ? 'selected' : '' %>>Homework</option><option <%= item.type === 'Upcoming test' ? 'selected' : '' %>>Upcoming test</option><option <%= item.type === 'Event' ? 'selected' : '' %>>Event</option><option <%= item.type === 'Project' ? 'selected' : '' %>>Project</option></select></label>
<label>Date<input name="due" type="date" value="<%= item.due !== 'No date' ? item.due : '' %>"></label>
<button class="button secondary" type="submit">Save</button>
</form>
<form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/delete" method="post"><button class="text-button" type="submit"><i data-lucide="trash-2"></i> Delete</button></form>
</details>
<% } %>
</div>
<details class="comment-details">
<summary>
<i data-lucide="message-circle">
</i> <span data-comment-count>
<%= item.comments.filter(comment => !comment.reported).length %>
</span> comments</summary>
<div class="comments">
<div class="comment-list" data-comment-list>
<% item.comments.filter(comment => !comment.reported).forEach(comment => { %>
<div class="comment-entry" data-comment-id="<%= comment.id %>"><div class="comment-body"><div class="comment-text"><strong><%= comment.author %></strong> <span><%= comment.text %></span><% if (comment.editedAt) { %><small class="comment-edited">edited</small><% } %></div><% if (comment.userId === user.id || member?.role === 'admin') { %><form class="comment-edit-form" data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/comments/<%= comment.id %>/update" method="post" hidden><input type="text" name="comment" value="<%= comment.text %>" required><div class="comment-edit-actions"><button class="button secondary" type="submit">Save</button><button class="text-button" type="button" data-comment-edit-cancel>Cancel</button></div></form><% } %></div><details class="comment-menu"><summary class="icon-button" aria-label="More comment actions"><i data-lucide="ellipsis"></i></summary><div class="comment-menu-popover"><% if (comment.userId === user.id || member?.role === 'admin') { %><button class="menu-action" type="button" data-comment-edit-open><i data-lucide="pencil"></i> Edit comment</button><% } %><form data-live-form action="/org/<%= selectedOrg.id %>/content-reports" method="post"><input type="hidden" name="contentId" value="<%= comment.id %>"><button class="menu-action" type="submit"><i data-lucide="flag"></i> Report comment</button></form><% if (comment.userId === user.id || member?.role === 'admin') { %><form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/comments/<%= comment.id %>/delete" method="post"><button class="menu-action danger" type="submit"><i data-lucide="trash-2"></i> Delete comment</button></form><% if (comment.history?.length) { %><details class="comment-history"><summary><i data-lucide="history"></i> Show edited comment</summary><div><% comment.history.slice().reverse().forEach(version => { %><p><%= version.text %><small><%= new Date(version.editedAt).toLocaleString() %> · <%= version.editorName %></small></p><% }) %></div></details><% } %><% } %></div></details>
</div>
<% }) %>
</div>
<form data-live-form action="/org/<%= selectedOrg.id %>/items/<%= item.id %>/comments" method="post">
<input name="comment" placeholder="Ask a question or share a note..." required>
<small class="form-error" data-form-error hidden></small>
<button class="button primary" type="submit">Reply</button>
</form>
</div>
</details>
</div>
</article>
<% }) %>
</div></section><% }) %>
<% if (!course.items.length) { %><div class="empty-panel" data-empty-feed>
<i data-lucide="message-square-plus">
</i>
<h3>The feed is waiting</h3>
<p>Post the first deadline, study guide, or class event.</p>
</div>
<% } %>
</div>
</section>
<section id="board" class="course-view" data-course-view="board">
<div class="rail-panel board-panel">
<div class="panel-heading">
<div>
<p class="eyebrow">PROJECT BOARD</p>
<h2>Claimable work</h2>
</div>
<span class="progress-ring">
<%= course.board?.length || 0 %>
</span>
</div>
<div class="board-column" data-board-list>
<% (course.board || []).forEach(card => { %>
<div class="claim-row" data-card-id="<%= card.id %>">
<span>
<strong>
<%= card.title %>
</strong>
<small>
<%= card.status %>
</small>
</span>
<% if (member?.role === 'admin' || member?.role === 'moderator') { %><form data-live-form action="/org/<%= selectedOrg.id %>/course/<%= course.id %>/board/<%= card.id %>/delete" method="post"><button class="icon-button" type="submit" aria-label="Delete board task"><i data-lucide="trash-2"></i></button></form><% } else { %><i data-lucide="arrow-right">
</i>
<% } %>
</div>
<% }) %>
<% if (!(course.board || []).length) { %>
<div class="claim-row" data-empty-board>
<span>Start a board card for shared work.</span>
<i data-lucide="plus">
</i>
</div>
<% } %>
</div>
<% if (canEdit(member)) { %>
<form class="inline-tool-form" data-live-form action="/org/<%= selectedOrg.id %>/course/<%= course.id %>/board" method="post">
<input name="title" placeholder="Add a board task" required>
<button class="button secondary" type="submit">Add task</button>
</form>
<% } %>
</div>
</section>
<section id="resources" class="course-view" data-course-view="resources">
<div class="rail-panel resource-panel">
<div class="panel-heading">
<h2>Resource hub</h2>
<i data-lucide="paperclip">
</i>
</div>
<p class="muted">Keep rubrics, decks, and shared links with the course.</p>
<div class="resource-list" data-resource-list>
<% (course.resources || []).forEach(resource => { %>
<div class="resource-row" data-resource-id="<%= resource.id %>"><a class="resource-link" href="<%= resource.url %>" target="_blank" rel="noreferrer">
<i data-lucide="external-link">
</i>
<span>
<%= resource.title %>
</span>
</a>
<% if (member?.role === 'admin' || member?.role === 'moderator') { %><form data-live-form action="/org/<%= selectedOrg.id %>/course/<%= course.id %>/resources/<%= resource.id %>/delete" method="post"><button class="icon-button" type="submit" aria-label="Delete resource"><i data-lucide="trash-2"></i></button></form><% } %></div>
<% }) %>
</div>
<% if (canEdit(member)) { %>
<form class="inline-tool-form" data-live-form action="/org/<%= selectedOrg.id %>/course/<%= course.id %>/resources" method="post">
<input name="title" placeholder="Resource name" required>
<input name="url" type="url" placeholder="https://..." required>
<button class="button secondary" type="submit">Add resource</button>
</form>
<% } %>
</div>
</section>
</div>
</section>