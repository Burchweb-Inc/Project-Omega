<style>
  .site-admin-tabs { display: flex; gap: 20px; margin: 0 0 24px; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .site-admin-tabs a { display: inline-flex; align-items: center; gap: 6px; padding: 0 0 12px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .site-admin-tabs a.active { color: var(--blue); border-bottom: 2px solid var(--coral); }
  .announcement-form { display: grid; gap: 16px; }
  .announcement-form textarea { min-height: 260px; resize: vertical; font-family: 'DM Sans', sans-serif; line-height: 1.6; }
  .announcement-form .form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  .announcement-history { display: grid; gap: 12px; margin-top: 18px; }
  .announcement-history article { padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); }
  .announcement-history h3 { margin-bottom: 6px; }
  .announcement-history small { color: var(--muted); }
  .moderation-tools { display: grid; grid-template-columns: minmax(220px, .75fr) minmax(0, 1.25fr); gap: 24px; align-items: start; margin-bottom: 26px; }
  .moderation-tools > form { align-self: start; }
  .review-log-list { display: grid; gap: 10px; }
  .review-log-list .admin-section-heading { margin-bottom: 2px; }
  .review-log { padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); }
  .review-log p { margin: 6px 0 0; }
  .site-admin-reports { margin-top: 24px; }
  @media (max-width: 800px) { .moderation-tools { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .announcement-form .form-grid { grid-template-columns: 1fr; } }
</style>
<section class="content-wrap site-admin-page">
  <div class="page-heading hero-heading"><div><p class="kicker">SITE ADMINISTRATION</p><h1>Keep the whole space healthy.</h1><p class="lead">Manage the whole site from one focused workspace.</p></div></div>
  <nav class="site-admin-tabs" aria-label="Site Admin sections">
    <a class="<%= siteAdminTab === 'admins' ? 'active' : '' %>" href="/site-admin?tab=admins"><i data-lucide="shield-check"></i> Admins</a>
    <a class="<%= siteAdminTab === 'groups' ? 'active' : '' %>" href="/site-admin?tab=groups"><i data-lucide="users-round"></i> Groups</a>
    <a class="<%= siteAdminTab === 'moderation' ? 'active' : '' %>" href="/site-admin?tab=moderation"><i data-lucide="message-square-more"></i> Moderation</a>
    <a class="<%= siteAdminTab === 'feedback' ? 'active' : '' %>" href="/site-admin?tab=feedback"><i data-lucide="messages-square"></i> Feedback</a>
    <a class="<%= siteAdminTab === 'announcements' ? 'active' : '' %>" href="/site-admin?tab=announcements"><i data-lucide="megaphone"></i> Announcements</a>
    <a class="<%= siteAdminTab === 'cache' ? 'active' : '' %>" href="/site-admin?tab=cache"><i data-lucide="database-zap"></i> Cache</a>
  </nav>

  <% if (siteAdminTab === 'admins') { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Site admins</h2><p class="muted">Only explicit site admins appear here. Site admins remain invisible in group member lists unless invited.</p></div></div>
      <form data-live-form action="/site-admin/users" method="post" class="inline-admin-form"><input name="username" placeholder="Search by username" required><button class="button secondary" type="submit"><i data-lucide="user-plus"></i> Add admin</button></form>
      <div class="site-admin-list"><% siteAdminUsers.forEach(admin => { %><div><span class="avatar"><%= admin.name[0] %></span><span><strong><%= admin.name %></strong><small>@<%= admin.username %></small></span></div><% }) %></div>
    </section>
  <% } else if (siteAdminTab === 'groups') { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Group list</h2><p class="muted">Search all active groups and jump straight in.</p></div></div>
      <label class="search-field"><i data-lucide="search"></i><input type="search" data-group-search placeholder="Search groups by name" aria-label="Search groups"></label>
      <div class="site-admin-group-list"><% orgs.forEach(org => { %><div class="site-admin-row" data-group-row data-group-name="<%= org.name %>"><div><strong><%= org.name %></strong><small><%= org.members.length %> members</small></div><a class="text-button" href="/org/<%= org.id %>">Visit group</a></div><% }) %></div>
    </section>
  <% } else if (siteAdminTab === 'moderation') { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Moderation queue</h2><p class="muted">Review comments across every group.</p></div><form data-live-form action="/site-admin/force-ai-update" method="post"><button class="button secondary" type="submit"><i data-lucide="refresh-cw"></i> Force AI update queue</button></form></div>
      <div class="moderation-tools">
        <form data-live-form action="/site-admin/bad-words" method="post" class="inline-admin-form"><label> Add a blocked word or phrase<input name="word" maxlength="200" placeholder="word or phrase" required></label><button class="button secondary" type="submit"><i data-lucide="plus"></i> Add to list</button></form>
        <div class="review-log-list"><div class="admin-section-heading"><div><h3>AI update log</h3><p class="muted">The latest queue review results.</p></div></div><% if (badWordReviewLogs.length) { badWordReviewLogs.forEach(log => { %><article class="review-log"><strong><%= log.trigger === 'manual' ? 'Manual review' : 'Scheduled review' %></strong><small> · <%= new Date(log.created_at).toLocaleString() %></small><p>Checked <%= log.checked %>. Added: <%= log.keptWords.length ? log.keptWords.join(', ') : 'none' %>. Discarded: <%= log.removedWords.length ? log.removedWords.join(', ') : 'none' %><% if (log.fallback) { %>. Status: <%= log.fallback %><% } %></p></article><% }) } else { %><p class="muted">No AI update runs have processed queued entries.</p><% } %></div>
      </div>
      <section class="site-admin-reports" data-report-queue>
        <div class="admin-section-heading"><div><h2>Reports from every group</h2><p class="muted">Review reports submitted across the whole site.</p></div><strong class="queue-count"><%= siteAdminReports.length %> open</strong></div>
        <% if (siteAdminReports.length) { siteAdminReports.forEach(report => { %>
          <article class="report-row" data-report-id="<%= report.id %>"><div><div class="report-meta"><span><%= report.type === 'content' ? 'Content report' : 'Group report' %></span><small><%= new Date(report.createdAt).toLocaleString() %></small></div><h3><%= report.reason %></h3><p class="muted">Group: <%= report.orgName %></p><blockquote class="reported-content"><%= report.contentText || report.detail || 'No content snapshot was recorded.' %></blockquote><p><%= report.detail || 'No additional details.' %></p><small>Reported by @<%= report.reporter %></small></div><div class="report-actions"><form data-live-form action="/org/<%= report.orgId %>/admin/reports/<%= report.id %>/action" method="post"><input type="hidden" name="action" value="close"><button class="button secondary" type="submit"><i data-lucide="archive"></i> Close</button></form><form data-live-form action="/org/<%= report.orgId %>/admin/reports/<%= report.id %>/action" method="post"><input type="hidden" name="action" value="remove"><button class="button danger" type="submit"><i data-lucide="trash-2"></i> Remove content</button></form><button class="button danger" type="button" data-open="site-report-action-<%= report.id %>"><i data-lucide="shield-alert"></i> Mod action</button></div><div id="site-report-action-<%= report.id %>" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="site-report-action-title-<%= report.id %>"><div class="modal-card report-action-modal"><button class="modal-close" data-close aria-label="Close moderation action" type="button"><i data-lucide="x"></i></button><p class="kicker">MOD ACTION</p><h2 id="site-report-action-title-<%= report.id %>">Choose a user consequence</h2><p class="muted">Warn, suspend, or ban the author.</p><form data-live-form action="/org/<%= report.orgId %>/admin/reports/<%= report.id %>/action" method="post" class="report-action-form"><label>Consequence<select name="action" required><option value="warn">Warn user</option><option value="remove-moderate">Suspend temporarily</option><option value="ban">Ban permanently</option></select></label><label class="suspension-field">Suspension days<input name="days" type="number" min="1" max="30" value="7"></label><label>Message to member<textarea name="message" maxlength="500" placeholder="Required for a warning; optional for suspension or ban"></textarea></label><div class="form-actions"><button class="button secondary" data-close type="button">Cancel</button><button class="button danger" type="submit">Apply mod action</button></div></form></div></div></article>
        <% }) } else { %><div class="empty-panel" data-report-empty><i data-lucide="flag"></i><h3>No open reports</h3><p>Reports from every group will appear here.</p></div><% } %>
      </section>
      <% if (siteAdminComments.length) { siteAdminComments.forEach((comment, index) => { %>
        <article class="mod-card<%= index === 0 ? ' is-next' : '' %>"><div class="mod-card-top"><span class="mod-number"><%= index + 1 %></span><div><strong><%= comment.author %></strong><span class="muted"> in <%= comment.source %> · <%= comment.orgName %></span></div><small><%= new Date(comment.createdAt).toLocaleString() %></small></div><p class="mod-text"><%= comment.text %></p><div class="mod-actions"><form data-live-form action="/org/<%= comment.orgId %>/admin/comments/<%= comment.id %>/review" method="post"><button class="button primary" type="submit"><i data-lucide="check"></i> Keep and mark reviewed</button></form><form data-live-form action="/org/<%= comment.orgId %>/admin/comments/<%= comment.id %>/remove" method="post"><button class="button danger" type="submit"><i data-lucide="trash-2"></i> Remove</button></form></div></article>
      <% }) } else { %><div class="empty-panel mod-empty"><i data-lucide="badge-check"></i><h3>Everything is reviewed</h3><p>New comments will appear here when they need an admin decision.</p></div><% } %>
    </section>
  <% } else if (siteAdminTab === 'feedback') { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Feedback</h2><p class="muted">Notes from people using beta and the rest of the site.</p></div></div>
      <% if (feedback.length) { feedback.forEach(item => { %><div class="site-admin-row" data-feedback-id="<%= item.id %>"><div><strong><%= item.kind %> · @<%= item.username %></strong><p><%= item.message %></p><small><%= new Date(item.created_at).toLocaleString() %></small></div><form data-live-form action="/site-admin/feedback/<%= item.id %>/status" method="post"><input type="hidden" name="status" value="<%= item.status === 'open' ? 'closed' : 'open' %>"><button class="text-button" type="submit"><%= item.status === 'open' ? 'Close' : 'Reopen' %></button></form></div><% }) } else { %><p class="muted">No feedback yet.</p><% } %>
    </section>
  <% } else if (siteAdminTab === 'cache') { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Remote cache control</h2><p class="muted">This tells connected browsers to unregister their service workers, delete every Cache Storage entry for this site, and reload. It does not delete user data.</p></div></div>
      <form class="inline-admin-form" data-live-form action="/site-admin/cache" method="post"><label class="cache-target-field">Username <span class="muted">leave blank for everyone</span><input name="username" placeholder="username"></label><button class="button danger" type="submit"><i data-lucide="bomb"></i> Nuke cache</button></form>
      <p class="muted cache-warning"><i data-lucide="triangle-alert"></i> The selected browser will lose offline media and any locally cached files. The next load downloads fresh versions and may take longer.</p>
    </section>
  <% } else { %>
    <section class="admin-panel">
      <div class="admin-section-heading"><div><h2>Broadcast announcement</h2><p class="muted">Every user will receive a popup. Markdown supports headings, links, lists, emphasis, code, tables, and images.</p></div></div>
      <form class="announcement-form" data-live-form action="/site-admin/announcements" method="post"><label>Title<input name="title" maxlength="160" required placeholder="A clear title for everyone"></label><label>Message<textarea name="body" maxlength="30000" required placeholder="# What is changing?&#10;&#10;Write the full announcement in Markdown.&#10;&#10;- Use **bold** and links&#10;- Add images with `![alt text](https://...)`"></textarea></label><div class="form-grid"><label>Media link <span class="muted">optional</span><input name="mediaUrl" type="url" placeholder="https://..."></label><label>Media type<select name="mediaType"><option value="none">None</option><option value="image">Image</option><option value="video">Video</option></select></label><label>Text size<select name="fontSize"><option value="normal">Normal</option><option value="small">Small</option><option value="large">Large</option></select></label></div><button class="button primary" type="submit"><i data-lucide="send"></i> Broadcast to all users</button></form>
    </section>
    <section class="admin-panel announcement-history"><div class="admin-section-heading"><div><h2>Announcement history</h2><p class="muted">Previously broadcast announcements.</p></div></div><% if (announcements.length) { announcements.forEach(announcement => { %><article><h3><%= announcement.title %></h3><small><%= new Date(announcement.created_at).toLocaleString() %> · <%= announcement.media_type === 'none' ? 'No media' : announcement.media_type %></small></article><% }) } else { %><p class="muted">No announcements yet.</p><% } %></section>
  <% } %>
</section>
