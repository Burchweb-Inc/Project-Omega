<section class="content-wrap calendar-page"><div class="page-heading hero-heading"><div><p class="eyebrow">ALL YOUR CLASSES</p><h1>Academic calendar</h1><p class="lead">One view for deadlines, exams, and school events across every space.</p></div><div class="calendar-actions"><button class="icon-button" aria-label="Previous month"><i data-lucide="chevron-left"></i></button><strong>September 2026</strong><button class="icon-button" aria-label="Next month"><i data-lucide="chevron-right"></i></button></div></div><div class="calendar-legend"><span><i class="legend-dot homework-dot"></i> Homework</span><span><i class="legend-dot test-dot"></i> Tests & quizzes</span><span><i class="legend-dot event-dot"></i> Events</span></div><div class="calendar-board"><div class="calendar-week"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span><span>SUN</span></div><div class="calendar-days"><% for (let day = 1; day <= 30; day++) { const dayItems = calendarItems.filter(entry => entry.due.endsWith(`-${String(day).padStart(2, '0')}`)); %><div class="calendar-day <%= day === 17 ? 'today' : '' %>"><strong><%= day %></strong><% dayItems.slice(0, 2).forEach(entry => { %><a class="calendar-event <%= entry.type === 'Event' ? 'event-event' : entry.type === 'Upcoming test' ? 'test-event' : 'homework-event' %>" href="/org/<%= entry.org.id %>/course/<%= entry.course.id %>"><%= entry.title %></a><% }) %></div><% } %></div></div></section>
