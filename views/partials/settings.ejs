<section class="content-wrap settings-page"><a class="back-link" href="/org/<%= selectedOrg.id %>"><i data-lucide="arrow-left"></i> <%= selectedOrg.name %></a><div class="page-heading"><div><p class="kicker">GROUP SETTINGS</p><h1>Settings</h1><p class="muted">Control visibility, sharing, access, and reports.</p></div></div><div class="settings-layout"><nav class="settings-nav"><a class="active" href="#access">Access</a><a href="#sharing">Sharing</a><a href="#safety">Safety</a></nav><div class="settings-sections"><section id="access" class="settings-section"><div><h2>Who can enter</h2><p class="muted">Choose how people discover and join <%= selectedOrg.name %>.</p></div><form action="/org/<%= selectedOrg.id %>/settings" method="post" class="page-form"><label>Visibility<select name="visibility"><option value="private" <%= selectedOrg.visibility === 'private' ? 'selected' : '' %>>Private · members only</option><option value="share" <%= selectedOrg.visibility === 'share' ? 'selected' : '' %>>Share · anyone with a link</option><option value="public" <%= selectedOrg.visibility === 'public' ? 'selected' : '' %>>Public · discoverable by everyone</option></select></label><p class="fine-print">Public groups are discoverable. Editors can create and edit course work. Admins manage members and settings.</p><button class="button primary">Save visibility</button></form></section><section id="sharing" class="settings-section"><div><h2>Share link</h2><p class="muted">A link can grant access a limited number of times.</p></div><form action="/org/<%= selectedOrg.id %>/settings" method="post" class="page-form"><input type="hidden" name="visibility" value="<%= selectedOrg.visibility %>"><div class="settings-note"><i data-lucide="link-2"></i><div><strong>Active link</strong><a href="/share/<%= selectedOrg.shareCode %>">studyline.local/share/<%= selectedOrg.shareCode %></a></div></div><label>Default permission<select name="sharePermission"><option value="viewer" <%= selectedOrg.sharePermission === 'viewer' ? 'selected' : '' %>>Viewer</option><option value="editor" <%= selectedOrg.sharePermission === 'editor' ? 'selected' : '' %>>Editor</option></select></label><label>Uses before deactivation<input name="shareUses" type="number" min="1" value="<%= selectedOrg.shareUses %>"></label><button class="button primary">Update share link</button></form></section><section id="safety" class="settings-section"><div><h2>Report something</h2><p class="muted">Tell us about inappropriate content or behavior.</p></div><form action="/org/<%= selectedOrg.id %>/reports" method="post" class="page-form"><label>Reason<select name="reason"><option>Inappropriate content</option><option>Harassment</option><option>Spam</option><option>Other</option></select></label><label>Details<textarea name="detail" placeholder="Tell us what happened..." required></textarea></label><button class="button danger">Submit report</button></form><% if (member?.role === 'admin' && selectedOrg.reports?.length) { %><div class="report-list"><h3>Open reports</h3><% selectedOrg.reports.filter(report => report.status === 'open').forEach(report => { %><article class="report-row"><div><strong><%= report.reason %></strong><p><%= report.detail %></p><small>Reported by @<%= report.reporter %></small></div><form action="/org/<%= selectedOrg.id %>/reports/<%= report.id %>/close" method="post"><button class="button secondary" type="submit">Close report</button></form></article><% }) %></div><% } %></section></div></div></section>