<style>
  .time {
    font-size: 1.5rem;
    color: var(--muted);
  }

  .page-heading .hero {
    display: inline-block;
    min-height: 0;
  }

  .hero-fade-in {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-fade-out {
    opacity: 0;
    transform: translateY(-8px);
  }

  .spbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 175px;
    max-width: 175px;
  }

  .dashboard-tabs {
    display: flex;
    gap: 20px;
    margin: 0 0 24px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }

  .dashboard-tabs a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    position: relative;
    padding: 0 0 12px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .dashboard-tabs a.active {
    color: var(--blue);
  }

  .dashboard-tabs a.active::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--coral);
    border-radius: 999px;
  }

  .dashboard-shell {
    display: grid;
    gap: 18px;
  }

  .dashboard-tab-panel {
    display: none;
    gap: 18px;
  }

  .dashboard-tab-panel.active {
    display: grid;
  }

  .dashboard-group-search {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 14px 16px;
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .dashboard-group-search input {
    flex: 1;
    min-width: 0;
  }

  .dashboard-group-list {
    display: grid;
    gap: 10px;
  }

  .dashboard-group-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 17px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .dashboard-group-item.hidden {
    display: none;
  }

  .dashboard-group-item strong {
    display: block;
    font-size: 14px;
  }

  .dashboard-group-item small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
  }

  .dashboard-group-item .group-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dashboard-moderation-list {
    display: grid;
    gap: 12px;
  }

  .dashboard-moderation-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
    padding: 16px 18px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .dashboard-moderation-item[data-dashboard-comment] {
    border-color: #f1d4c0;
  }

  .dashboard-moderation-item strong {
    display: block;
    font-size: 14px;
  }

  .dashboard-moderation-item p {
    margin: 7px 0 0;
    line-height: 1.55;
  }

  .dashboard-moderation-item small {
    display: block;
    margin-top: 8px;
    color: var(--muted);
  }

  .moderation-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .moderation-actions form {
    margin: 0;
  }

  @media (max-width: 700px) {
    .dashboard-group-item,
    .dashboard-moderation-item {
      grid-template-columns: 1fr;
      display: grid;
    }

    .dashboard-group-item .group-actions,
    .moderation-actions {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }
</style>

<section class="content-wrap dashboard-page" data-dashboard-live data-user-id="<%= user.id %>" data-user-name="<%= user.name %>">
  <div class="page-heading hero-heading">
    <div>
      <p class="time">YOUR STUDY DESK</p>
      <h1 class="hero">Make today easier to carry.</h1>
      <p class="lead">Hey, <%= user.name %>, ready to get some work done?</p>
    </div>
    <a class="spbtn lui-button lui-button-primary" href="/org/new"><i data-lucide="plus"></i> New Group</a>
  </div>

  <nav class="dashboard-tabs" aria-label="Dashboard sections">
    <a class="<%= dashboardTab === 'overview' ? 'active' : '' %>" href="/dashboard?tab=overview">Overview</a>
    <a class="<%= dashboardTab === 'groups' ? 'active' : '' %>" href="/dashboard?tab=groups">Group list</a>
    <a class="<%= dashboardTab === 'moderate' ? 'active' : '' %>" href="/dashboard?tab=moderate">Moderate</a>
  </nav>

  <div class="dashboard-shell">
    <% if (dashboardTab === 'overview') { %>
    <section class="dashboard-tab-panel active">
      <div class="metric-grid">
        <div class="metric-card metric-accent"><span>Still to do</span><strong data-dashboard-todo-count><%= (user.tasks || []).filter(task => !task.done).length %></strong><small>tasks in your personal queue</small></div>
        <div class="metric-card"><span>Your classes</span><strong><%= dashboardCourses.length %></strong><small>connected to your desk</small></div>
        <div class="metric-card"><span>Class updates</span><strong data-dashboard-feed-count><%= feedTotal %></strong><small>in your latest activity</small></div>
        <div class="metric-card"><span>Study groups</span><strong><%= dashboardGroups.reduce((count, org) => count + (org.groups || []).length, 0) %></strong><small>ready to work together</small></div>
      </div>
      <div class="dashboard-grid dashboard-home-grid">
        <section class="dashboard-feed-column">
          <div class="dashboard-section-heading">
            <div><h1>Your Feed</h1></div>
            <a class="lui-button lui-button-quiet" href="/calendar">Calendar <i data-lucide="arrow-up-right"></i></a>
          </div>
          <div class="dashboard-live-status" data-dashboard-feed-status role="status" aria-live="polite"></div>
          <div class="dashboard-feed-list" data-dashboard-feed-list>
            <% feedItems.forEach(entry => { %>
              <article class="lui-card dashboard-feed-post" data-item-id="<%= entry.id %>" data-org-id="<%= entry.org.id %>" data-course-id="<%= entry.course.id %>" data-type="<%= entry.type %>" data-due="<%= entry.due || '' %>" data-priority="<%= entry.priority || '' %>">
                <header class="dashboard-post-header">
                  <div class="dashboard-post-source"><strong><%= entry.course.name %></strong><span><%= entry.org.name %> · <%= entry.type %></span></div>
                  <span class="dashboard-post-date"><i data-lucide="calendar-days" aria-hidden="true"></i><%= entry.due || 'No date' %></span>
                </header>
                <div class="dashboard-post-copy">
                  <h3><%- renderLinkedText(entry.title, entry.links) %></h3>
                  <% if (entry.details) { %><p><%- renderLinkedText(entry.details, entry.links) %></p><% } %>
                </div>
                <div class="dashboard-post-actions">
                  <form data-live-form action="/org/<%= entry.org.id %>/items/<%= entry.id %>/verify" method="post">
                    <button class="lui-button lui-button-quiet dashboard-confirm-action <%= (entry.verifiedBy || []).includes(user.id) ? 'is-confirmed' : '' %>" type="submit" aria-pressed="<%= (entry.verifiedBy || []).includes(user.id) %>">
                      <i data-lucide="badge-check"></i><span><%= (entry.verifiedBy || []).includes(user.id) ? 'Confirmed' : 'Confirm' %></span><strong data-verify-count><%= (entry.verifiedBy || []).length %></strong>
                    </button>
                  </form>
                  <% if (entry.type !== 'Event') { %>
                    <form data-live-form action="/org/<%= entry.org.id %>/items/<%= entry.id %>/todo" method="post">
                      <button class="lui-button lui-button-quiet" type="submit"><i data-lucide="list-plus"></i> Add to Todo</button>
                    </form>
                  <% } %>
                  <% if (entry.type === 'Project') { %>
                    <a class="lui-button lui-button-quiet" href="/org/<%= entry.org.id %>/course/<%= entry.course.id %>/task/<%= `${entry.title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || entry.id}-${entry.id.slice(-8)}` %>/breakout-groups"><i data-lucide="users-round"></i> Breakout groups</a>
                  <% } %>
                  <a class="lui-button lui-button-quiet dashboard-open-course" href="/org/<%= entry.org.id %>/course/<%= entry.course.id %>#feed"><i data-lucide="arrow-up-right"></i> Class thread</a>
                </div>
                <details class="dashboard-post-comments">
                  <summary><i data-lucide="message-circle"></i> <span data-comment-count><%= (entry.comments || []).filter(comment => !comment.reported).length %></span> comments <i data-lucide="chevron-down"></i></summary>
                  <div class="dashboard-comment-list" data-comment-list>
                    <% (entry.comments || []).filter(comment => !comment.reported).forEach(comment => { %>
                      <article class="dashboard-comment" data-comment-id="<%= comment.id %>"><strong><%= comment.author %></strong><p><%= comment.text %></p></article>
                    <% }) %>
                  </div>
                  <form class="dashboard-comment-form" data-live-form action="/org/<%= entry.org.id %>/items/<%= entry.id %>/comments" method="post">
                    <label class="sr-only" for="comment-<%= entry.id %>">Add a comment</label>
                    <input id="comment-<%= entry.id %>" name="comment" placeholder="Add to the class conversation..." required>
                    <button class="lui-icon-button" type="submit" aria-label="Post comment"><i data-lucide="send"></i></button>
                  </form>
                </details>
              </article>
            <% }) %>
            <% if (!feedItems.length) { %>
              <div class="lui-panel dashboard-feed-empty"><i data-lucide="messages-square"></i><h3>Your class feed is ready</h3><p>When a class shares a deadline or project, it will show up here.</p><a class="lui-button lui-button-secondary" href="/groups">Find a class</a></div>
            <% } %>
          </div>
          <div class="dashboard-feed-pagination" data-dashboard-feed-pagination data-offset="<%= feedItems.length %>" data-page-size="<%= feedPageSize %>" data-has-more="<%= feedHasMore %>">
            <button class="lui-button lui-button-secondary" type="button" data-dashboard-feed-more <%= feedHasMore ? '' : 'hidden' %>>Load <%= feedPageSize %> more</button>
            <span class="sr-only" data-dashboard-feed-page-status role="status" aria-live="polite"></span>
          </div>
          <div class="dashboard-course-rooms" hidden aria-hidden="true">
            <% dashboardCourses.forEach(course => { %><span data-dashboard-course data-org-id="<%= course.orgId %>" data-org-name="<%= course.orgName %>" data-course-id="<%= course.courseId %>" data-course-name="<%= course.courseName %>" data-course-code="<%= course.courseCode || '' %>" data-course-color="<%= course.courseColor || '#547484' %>"></span><% }) %>
          </div>
        </section>

        <aside class="dashboard-rail dashboard-home-rail">
          <section class="lui-panel dashboard-todo-panel">
            <div class="dashboard-section-heading">
              <div><h2>Personal Todo</h2><p><span data-dashboard-todo-count><%= (user.tasks || []).filter(task => !task.done).length %></span> still in motion</p></div>
              <a class="lui-icon-button" href="/todo" aria-label="Expand and open Personal Todo"><i data-lucide="arrow-up-right"></i></a>
            </div>
            <div class="dashboard-todo-list" data-live-todo-list data-dashboard-todo-list>
              <% (user.tasks || []).forEach(task => { %>
                <article class="dashboard-todo-item <%= task.done ? 'is-done' : '' %>" data-task-id="<%= task.id %>">
                  <form class="toggle-task-form" action="/tasks/<%= task.id %>/toggle" method="post" data-live-form>
                    <button class="lui-check dashboard-todo-check" type="submit" aria-label="<%= task.done ? 'Mark incomplete' : 'Mark complete' %>: <%= task.title %>"><i data-lucide="check"></i></button>
                  </form>
                  <div><strong><%- renderLinkedText(task.title, task.links) %></strong><small><%= task.source %></small></div>
                </article>
              <% }) %>
              <% if (!(user.tasks || []).length) { %><p class="dashboard-todo-empty">Your private queue is clear. Add a task from any class feed.</p><% } %>
            </div>
            <p class="sr-only" data-dashboard-todo-status role="status" aria-live="polite"></p>
            <a class="lui-button lui-button-primary dashboard-expand-todo" href="/todo">Open full Todo <i data-lucide="arrow-up-right"></i></a>
          </section>
          <section class="lui-card dashboard-groups-card">
            <i data-lucide="users-round" aria-hidden="true"></i>
            <h2>Working on a project?</h2>
            <p>Open a project’s breakout groups from its feed post to split up the work and keep it moving.</p>
            <a class="lui-link" href="/groups">Browse your groups <i data-lucide="arrow-right"></i></a>
          </section>
        </aside>
      </div>
    </section>
    <% } else if (dashboardTab === 'groups') { %>
    <section class="dashboard-tab-panel active">
      <div class="dashboard-group-search">
        <i data-lucide="search"></i>
        <input name="groupSearch" data-dashboard-group-search placeholder="Search groups by name" autocomplete="off">
      </div>
      <div class="dashboard-group-list">
        <% dashboardGroups.forEach(org => { %>
          <article class="dashboard-group-item" data-org-id="<%= org.id %>">
            <div>
              <strong><%= org.name %></strong>
              <small><%= org.members?.length || 0 %> members · <%= org.groups?.length || 0 %> breakout groups</small>
            </div>
            <div class="group-actions">
              <a class="lui-button lui-button-secondary" href="/group/<%= org.slug || org.id %>">Visit group</a>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
    <% } else { %>
    <section class="dashboard-tab-panel active">
      <div class="admin-queue-head"><div><h2>Review new comments</h2><p class="muted">Work from the top until every new comment has a decision.</p></div><strong class="queue-count"><%= dashboardModeration.length %> left</strong></div>
      <div class="dashboard-moderation-list mod-queue">
        <% if (dashboardModeration.length) { %>
          <% dashboardModeration.forEach((comment, index) => { %>
            <article class="dashboard-moderation-item mod-card<%= index === 0 ? ' is-next' : '' %>" data-dashboard-comment data-dashboard-comment-id="<%= comment.id %>" data-org-id="<%= comment.orgId %>">
              <div class="mod-card-top"><span class="mod-number"><%= index + 1 %></span><div><strong><%= comment.author %></strong><span class="muted"> in <%= comment.source %> · <%= comment.orgName %></span></div><small><%= new Date(comment.createdAt).toLocaleString() %></small></div>
              <p class="mod-text"><%= comment.text %></p>
              <% if (comment.editedAt) { %><small class="comment-edited">Edited <%= new Date(comment.editedAt).toLocaleString() %></small><% } %>
              <div class="mod-actions moderation-actions">
                <form data-live-form action="/org/<%= comment.orgId %>/admin/comments/<%= comment.id %>/review" method="post">
                  <button class="lui-button lui-button-primary" type="submit"><i data-lucide="check"></i> Keep and mark reviewed</button>
                </form>
                <form data-live-form action="/org/<%= comment.orgId %>/admin/comments/<%= comment.id %>/remove" method="post">
                  <button class="lui-button lui-button-danger" type="submit"><i data-lucide="trash-2"></i> Remove</button>
                </form>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <div class="empty-panel mod-empty"><i data-lucide="badge-check"></i><h3>Everything is reviewed</h3><p>New comments will appear here when they need an admin decision.</p></div>
        <% } %>
      </div>
    </section>
    <% } %>
  </div>
</section>
