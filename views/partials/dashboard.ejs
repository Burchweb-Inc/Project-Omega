<section class="content-wrap dashboard-page">
  <div class="page-heading hero-heading"><div><p class="eyebrow">WEDNESDAY, SEPTEMBER 17</p><h1>Make today easier to carry.</h1><p class="lead">Your classes, people, and next steps in one calm view.</p></div><a class="button primary" href="/org/new"><i data-lucide="plus"></i> New study space</a></div>
  <div class="metric-grid"><div class="metric-card metric-accent"><span>Open tasks</span><strong><%= (user.tasks || []).filter(task => !task.done).length %></strong><small>in your private queue</small></div><div class="metric-card"><span>Course feeds</span><strong><%= orgs.reduce((count, org) => count + org.courses.length, 0) %></strong><small>across your spaces</small></div><div class="metric-card"><span>Peer signals</span><strong><%= feedItems.filter(entry => (entry.verifiedBy || []).length).length %></strong><small>items checked recently</small></div><div class="metric-card"><span>Groups</span><strong><%= orgs.reduce((count, org) => count + (org.groups || []).length, 0) %></strong><small>projects in motion</small></div></div>
  <div class="dashboard-grid"><section class="feed-panel"><div class="panel-heading"><div><p class="eyebrow">LIVE FROM YOUR SPACES</p><h2>Course activity</h2></div><a class="text-button" href="/calendar">View calendar <i data-lucide="arrow-up-right"></i></a></div><div class="feed-list"><% feedItems.forEach(entry => { %><article class="feed-card"><div class="feed-card-head"><span class="category-dot category-<%= entry.type.toLowerCase().replace(/[^a-z]/g, '-') %>"></span><div><span class="feed-source"><%= entry.course.name %> · <%= entry.org.name %></span><h3><%= entry.title %></h3></div><span class="feed-date"><%= entry.due %></span></div><div class="feed-card-foot"><span class="type-label"><%= entry.type %></span><span class="trust-count"><i data-lucide="shield-check"></i> <%= (entry.verifiedBy || []).length %> confirmed</span><a href="/org/<%= entry.org.id %>/course/<%= entry.course.id %>">Open thread <i data-lucide="arrow-right"></i></a></div></article><% }) %><% if (!feedItems.length) { %><div class="empty-panel"><i data-lucide="layers-2"></i><h3>Your course feed starts here</h3><p>Add a course and post the first deadline for your classmates.</p><a class="button secondary" href="/org/new">Create a study space</a></div><% } %></div></section><aside class="dashboard-rail"><section class="rail-panel"><div class="panel-heading"><div><p class="eyebrow">NEXT UP</p><h2>My Todo</h2></div><a class="icon-link" href="/todo" aria-label="Open Personal Todo"><i data-lucide="arrow-up-right"></i></a></div><div class="mini-tasks"><% (user.tasks || []).filter(task => !task.done).slice(0, 4).forEach(task => { %><div class="mini-task"><span class="mini-check"></span><div><strong><%= task.title %></strong><small><%= task.source %></small></div></div><% }) %><% if (!(user.tasks || []).filter(task => !task.done).length) { %><p class="muted">Your private queue is clear.</p><% } %></div><a class="rail-link" href="/todo">Open full Todo <i data-lucide="arrow-right"></i></a></section><section class="rail-panel group-callout"><div class="panel-heading"><div><p class="eyebrow">WORK TOGETHER</p><h2>Breakout groups</h2></div><i data-lucide="users-round"></i></div><p>Split project work, claim responsibilities, and keep the shared deadline visible.</p><a class="button secondary" href="/groups">Explore groups</a></section></aside></div>
</section>
