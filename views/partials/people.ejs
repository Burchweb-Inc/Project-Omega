<section class="content-wrap people-page">
  <a class="back-link" href="/org/<%= selectedOrg.id %>"><i data-lucide="arrow-left"></i> <%= selectedOrg.name %></a>
  <div class="people-heading page-heading"><div><p class="kicker">GROUP PEOPLE</p><h1>People</h1><p class="muted">Manage access, roles, and conduct consequences for this group.</p></div><% if (member?.role === 'admin') { %><a class="button primary" href="/org/<%= selectedOrg.id %>/people/new"><i data-lucide="user-plus"></i> Add person</a><% } %></div>
  <div class="people-overview"><div class="people-intro"><div class="people-intro-icon"><i data-lucide="users-round"></i></div><div><strong><%= selectedOrg.members.length %> <%= selectedOrg.members.length === 1 ? 'person' : 'people' %></strong><p>Everyone with access to <%= selectedOrg.name %>.</p></div></div><div class="role-key"><span><i class="role-dot admin"></i> Admin</span><span><i class="role-dot moderator"></i> Moderator</span><span><i class="role-dot editor"></i> Editor</span><span><i class="role-dot viewer"></i> Viewer</span></div></div>
  <div class="member-list clean-members"><div class="member-list-heading"><h2>Workspace members</h2><span><%= selectedOrg.members.length %> total</span></div><div class="member-cards">
    <% selectedOrg.members.forEach(person => { const personUser = users.find(user => user.id === person.userId) || { id: person.userId, name: 'Member', username: 'member', moderationStatus: 'active' }; const status = personUser.moderationStatus || 'active'; %>
      <article class="member-row">
        <span class="avatar"><%= personUser.name[0] %></span>
        <div class="member-identity"><strong><%= personUser.name %></strong><small>@<%= personUser.username %></small></div>
        <div class="member-access"><span class="role-label <%= person.role %>"><i data-lucide="<%= person.role === 'admin' ? 'shield-check' : person.role === 'moderator' ? 'shield' : person.role === 'editor' ? 'pencil-line' : 'eye' %>"></i><%= person.role %></span><small class="member-status <%= status %>"><%= status === 'active' ? 'In good standing' : status === 'suspended' ? 'Suspended until ' + new Date(personUser.moderationUntil).toLocaleDateString() : 'Permanently banned' %></small></div>
        <% if (member?.role === 'admin' && personUser.id !== user.id) { %>
          <details class="member-actions"><summary class="icon-button" aria-label="Manage <%= personUser.name %>"><i data-lucide="more-horizontal"></i></summary>
            <div class="member-actions-popover member-actions-panel">
              <div class="member-action-heading"><div><strong>Manage <%= personUser.name %></strong><small>Access and conduct controls</small></div><i data-lucide="shield-check"></i></div>
              <form data-live-form action="/org/<%= selectedOrg.id %>/members/<%= personUser.id %>/access" method="post" class="access-form"><label>Access<select name="role"><option value="viewer" <%= person.role === 'viewer' ? 'selected' : '' %>>Viewer</option><option value="editor" <%= person.role === 'editor' ? 'selected' : '' %>>Editor</option><option value="moderator" <%= person.role === 'moderator' ? 'selected' : '' %>>Moderator</option><option value="admin" <%= person.role === 'admin' ? 'selected' : '' %>>Admin</option></select></label><button class="button secondary" type="submit">Update access</button></form>
              <div class="member-action-divider"></div>
              <form data-live-form action="/org/<%= selectedOrg.id %>/members/<%= personUser.id %>/repercussion" method="post" class="conduct-form"><label>Moderation action<select name="action" required><option value="warning">Give warning</option><option value="suspension">Suspend temporarily</option><option value="ban">Ban permanently</option><% if (status !== 'active') { %><option value="unban">Restore access</option><% } %></select></label><label>Suspension days<input name="days" type="number" min="1" max="30" value="7"></label><label>Message to member<textarea name="message" placeholder="Optional context for this action"></textarea></label><button class="button danger" type="submit">Apply moderation action</button></form>
            </div>
          </details>
        <% } %>
      </article>
    <% }) %>
  </div></div>
</section>
