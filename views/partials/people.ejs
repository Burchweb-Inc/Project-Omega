<section class="content-wrap people-page"><a class="back-link" href="/org/<%= selectedOrg.id %>"><i data-lucide="arrow-left"></i> <%= selectedOrg.name %></a><div class="people-heading page-heading"><div><p class="kicker">ORGANIZATION PEOPLE</p><h1>People</h1><p class="muted">Manage who can access this study space and what they can change.</p></div><% if (member?.role === 'admin') { %><a class="button primary" href="/org/<%= selectedOrg.id %>/people/new"><i data-lucide="user-plus"></i> Add person</a><% } %></div><div class="people-overview"><div class="people-intro"><div class="people-intro-icon"><i data-lucide="users-round"></i></div><div><strong><%= selectedOrg.members.length %> <%= selectedOrg.members.length === 1 ? 'person' : 'people' %></strong><p>Everyone with access to <%= selectedOrg.name %>.</p></div></div><div class="role-key"><span><i class="role-dot admin"></i> Admin manages access</span><span><i class="role-dot editor"></i> Editor updates course work</span><span><i class="role-dot viewer"></i> Viewer follows along</span></div></div><div class="member-list clean-members"><div class="member-list-heading"><h2>Workspace members</h2><span><%= selectedOrg.members.length %> total</span></div><div class="member-cards"><% selectedOrg.members.forEach(person => { const personUser = users.find(u => u.id === person.userId) || { name: 'Member', username: 'member' }; %><article class="member-row"><span class="avatar"><%= personUser.name[0] %></span><div class="member-identity"><strong><%= personUser.name %></strong><small>@<%= personUser.username %></small></div><div class="member-access"><span class="role-label <%= person.role %>"><i data-lucide="<%= person.role === 'admin' ? 'shield-check' : person.role === 'editor' ? 'pencil-line' : 'eye' %>"></i><%= person.role %></span><small><%= person.role === 'admin' ? 'Can manage members' : person.role === 'editor' ? 'Can update course work' : 'Can view shared work' %></small></div><% if (member?.role === 'admin' && person.userId !== user.id) { %><form action="/org/<%= selectedOrg.id %>/members/<%= person.userId %>/remove" method="post"><button class="remove-member" aria-label="Remove <%= personUser.name %>" title="Remove member"><i data-lucide="user-minus"></i></button></form><% } %></article><% }) %></div></div></section>