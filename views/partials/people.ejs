<section class="content-wrap people-page"><a class="back-link" href="/org/<%= selectedOrg.id %>"><i data-lucide="arrow-left"></i> <%= selectedOrg.name %></a><div class="page-heading"><div><p class="kicker">ORGANIZATION PEOPLE</p><h1>People</h1><p class="muted">A clear view of who can access this study space.</p></div><% if (member?.role === 'admin') { %><a class="button primary" href="/org/<%= selectedOrg.id %>/people/new"><i data-lucide="user-plus"></i> Add person</a><% } %></div><div class="people-grid"><div class="people-intro"><i data-lucide="users"></i><strong><%= selectedOrg.members.length %> people</strong><p>Admins manage access. Editors can update course work. Viewers can follow along.</p></div><div class="member-list clean-members"><% selectedOrg.members.forEach(person => { const personUser = users.find(u => u.id === person.userId) || { name: 'Member', username: 'member' }; %><div class="member-row"><span class="avatar"><%= personUser.name[0] %></span><div><strong><%= personUser.name %></strong><small>@<%= personUser.username %></small></div><span class="role-label <%= person.role %>"><%= person.role %></span><% if (member?.role === 'admin' && person.userId !== user.id) { %><form action="/org/<%= selectedOrg.id %>/members/<%= person.userId %>/remove" method="post"><button class="remove-member" aria-label="Remove <%= personUser.name %>" title="Remove"><i data-lucide="user-minus"></i></button></form><% } %></div><% }) %></div></div></section>