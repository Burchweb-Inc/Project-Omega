<main class="landing-page">
        <section class="landing-hero">
            <canvas class="landing-shader" data-landing-shader aria-hidden="true"></canvas>
            <div class="landing-noise" aria-hidden="true"></div>
            <header class="landing-header">
                <a class="landing-brand" href="/" aria-label="LockIn home"><img src="/media/logo-text.png" alt="LockIn"></a>
                <nav class="landing-nav" aria-label="Landing page navigation">
                    <a href="#why-lockin">Why LockIn</a>
                    <a href="/about">About</a>
                    <a href="/support">Support</a>
                    <a class="landing-nav-button" href="#start">Open your desk <i data-lucide="arrow-up-right"></i></a>
                </nav>
            </header>

            <div class="landing-hero-grid">
                <div class="landing-copy">
                    <p class="landing-kicker"><span></span> A calmer place to do school together</p>
                    <h1>Make room for <em>the work</em> that matters.</h1>
                    <p class="landing-lead">Classes, deadlines, project teams, and the details your LMS misses. One clear place, built by peers and kept human.</p>
                    <div class="landing-actions">
                        <a class="button landing-action-primary" href="#start">Build your desk <i data-lucide="arrow-down"></i></a>
                        <a class="landing-action-link" href="/about">See what we stand for <i data-lucide="arrow-up-right"></i></a>
                    </div>
                    <div class="landing-trust"><span><i data-lucide="shield-check"></i> Strict moderation</span><span><i data-lucide="lock-keyhole"></i> Privacy by default</span><span><i data-lucide="heart-handshake"></i> Not-for-profit</span></div>
                </div>

                <div class="landing-stage" aria-label="LockIn study space principles">
                    <div class="landing-stage-frame">
                        <div class="landing-desk-art">
                            <div class="desk-art-grid" aria-hidden="true"></div>
                            <div class="desk-art-orbit orbit-large" aria-hidden="true"></div>
                            <div class="desk-art-orbit orbit-small" aria-hidden="true"></div>
                            <img src="/media/logo-text.png" alt="LockIn" class="desk-art-logo">
                            <span class="desk-art-label label-top">A CLEAR PLACE<br><strong>TO BEGIN</strong></span>
                            <span class="desk-art-label label-bottom">CLASSES / DEADLINES / PEOPLE</span>
                            <span class="desk-art-mark" aria-hidden="true">+</span>
                        </div>
                        <div class="landing-stage-caption"><span>THE ROOM</span><strong>is yours to shape.</strong></div>
                    </div>
                    <div class="landing-float float-focus"><i data-lucide="book-open"></i><span>Focus<br><strong>together</strong></span></div>
                    <div class="landing-float float-care"><i data-lucide="sparkles"></i><span>Make the<br><strong>in-between easier</strong></span></div>
                    <span class="landing-stage-line line-top" aria-hidden="true"></span><span class="landing-stage-line line-bottom" aria-hidden="true"></span>
                </div>
            </div>
            <div class="landing-scroll-cue"><span>Scroll to find your footing</span><i data-lucide="arrow-down"></i></div>
        </section>

        <section class="landing-principles" id="why-lockin">
            <div class="landing-section-intro"><p class="landing-kicker"><span></span> The point</p><h2>School is hard enough.<br><em>The tools should be kind.</em></h2></div>
            <div class="landing-principle-list">
                <article><span>01</span><i data-lucide="layout-dashboard"></i><h3>Everything in one clear room</h3><p>Keep classes, deadlines, resources, questions, and group work close enough to be useful.</p></article>
                <article><span>02</span><i data-lucide="users-round"></i><h3>Shared work without the performance</h3><p>Coordinate with peers without feeds designed to keep you scrolling or performing online.</p></article>
                <article><span>03</span><i data-lucide="shield-check"></i><h3>Care you can feel</h3><p>Strict moderation, privacy-minded infrastructure, and a product organized around usefulness.</p></article>
            </div>
        </section>

        <section class="landing-start" id="start">
            <div class="landing-start-copy"><p class="landing-kicker"><span></span> Student workspace</p><h2>Start with a clear desk.</h2><p>Create an account and make the everyday coordination around school a little less noisy.</p><div class="landing-start-note"><i data-lucide="wifi-off"></i><span>Ad-free and school-Wi-Fi friendly.</span></div></div>
            <div class="auth-card landing-auth-card">
                <h3>Make your space</h3>
                <p class="muted">No email required. Just a name, username, and password.</p>
                <% if (error) { %>
                    <div class="form-alert" role="alert"><i data-lucide="circle-alert"></i><span><%= error==='locked' ? 'Too many attempts. Try again in a few minutes.' : error==='signup' ? 'Check your details. Passwords need at least 8 characters and accounts are for students 13+.' : 'We could not sign you in. Check your username and password.' %></span></div>
                <% } %>
                <div class="tabs"><button type="button" class="tab <%= error === 'login' || error === 'locked' ? '' : 'active' %>" data-tab="signup">Create account</button><button type="button" class="tab <%= error === 'login' || error === 'locked' ? 'active' : '' %>" data-tab="login">Sign in</button></div>
                <form id="signup" class="auth-form <%= error === 'login' || error === 'locked' ? 'hidden' : '' %>" action="/signup" method="post"><label>What should we call you?<input name="name" autocomplete="name" placeholder="Alex Morgan" required></label><label>Choose a username<input name="username" autocomplete="username" placeholder="alexm" required></label><label>How old are you?<input name="age" type="number" min="13" placeholder="18" required></label><label>Create a password<input name="password" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters" required></label><button class="button primary full" type="submit">Create my workspace <i data-lucide="arrow-up-right"></i></button></form>
                <form id="login" class="auth-form <%= error === 'login' || error === 'locked' ? '' : 'hidden' %>" action="/login" method="post"><label>Username<input name="username" autocomplete="username" placeholder="alexm" required></label><label>Password<input name="password" type="password" autocomplete="current-password" placeholder="Your password" required></label><button class="button primary full" type="submit">Open my workspace <i data-lucide="arrow-up-right"></i></button></form>
            </div>
        </section>
        <footer class="landing-footer"><span>LockIn</span><span>Peer-powered, ad-free, and built for school networks.</span><span><a href="/about">About</a><a href="/support">Support</a><a href="/privacy">Privacy</a></span></footer>
</main>