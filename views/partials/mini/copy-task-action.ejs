<details class="task-menu copy-task-menu">
  <summary class="lui-icon-button" aria-label="More actions for <%= item.title %>"><i data-lucide="ellipsis"></i></summary>
  <div class="task-menu-popover">
    <button class="lui-menu-action" type="button" data-copy-task-open data-copy-url="/org/<%= selectedOrg.id %>/items/<%= item.id %>/copy" data-copy-title="<%= item.title %>">
      <i data-lucide="copy"></i> Copy task
    </button>
  </div>
</details>
