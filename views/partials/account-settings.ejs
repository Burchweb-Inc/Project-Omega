<section class="content-wrap account-settings-page">
  <a class="back-link" href="/dashboard"><i data-lucide="arrow-left"></i> My desk</a>
  <div class="page-heading"><div><p class="kicker">YOUR ACCOUNT</p><h1>Settings</h1><p class="muted">Control your profile, dates, time zone, and account access.</p></div></div>
  <div class="settings-layout">
    <nav class="settings-nav"><a class="active" href="#profile">Profile</a><a href="#dates">Dates & time</a><a href="#security">Security</a><a href="#account">Account</a></nav>
    <div class="settings-sections">
      <section class="settings-section" id="profile"><div><h2>Profile</h2><p class="muted">This is how people recognize you in groups.</p></div><form class="page-form" action="/settings" method="post" data-live-form><label>Name<input name="name" value="<%= user.name %>" required></label><label>Username<input name="username" value="<%= user.username %>" pattern="[a-z0-9_]{3,24}" required><small class="fine-print">3 to 24 lowercase letters, numbers, or underscores.</small></label><button class="button primary" type="submit">Save profile</button></form></section>
      <section class="settings-section" id="dates"><div><h2>Dates & time</h2><p class="muted">Automatic uses your IP when available. Local development uses the choices below.</p></div><form class="page-form" action="/settings" method="post" data-live-form><input type="hidden" name="name" value="<%= user.name %>"><input type="hidden" name="username" value="<%= user.username %>"><label>Date layout<select name="dateFormat"><option value="auto" <%= accountSettings.dateFormat === 'auto' || !accountSettings.dateFormat ? 'selected' : '' %>>Automatic by location</option><option value="mdy" <%= accountSettings.dateFormat === 'mdy' ? 'selected' : '' %>>MM/DD/YYYY</option><option value="dmy" <%= accountSettings.dateFormat === 'dmy' ? 'selected' : '' %>>DD/MM/YYYY</option><option value="ymd" <%= accountSettings.dateFormat === 'ymd' ? 'selected' : '' %>>YYYY/MM/DD</option></select></label><label>Time zone<select name="timezone"><option value="" <%= !accountSettings.timezone ? 'selected' : '' %>>Automatic by location</option><option value="Europe/Berlin" <%= accountSettings.timezone === 'Europe/Berlin' ? 'selected' : '' %>>Europe/Berlin</option><option value="America/New_York" <%= accountSettings.timezone === 'America/New_York' ? 'selected' : '' %>>America/New York</option><option value="America/Los_Angeles" <%= accountSettings.timezone === 'America/Los_Angeles' ? 'selected' : '' %>>America/Los Angeles</option><option value="Asia/Tokyo" <%= accountSettings.timezone === 'Asia/Tokyo' ? 'selected' : '' %>>Asia/Tokyo</option><option value="Australia/Sydney" <%= accountSettings.timezone === 'Australia/Sydney' ? 'selected' : '' %>>Australia/Sydney</option><option value="UTC" <%= accountSettings.timezone === 'UTC' ? 'selected' : '' %>>UTC</option></select></label><button class="button primary" type="submit">Save date preferences</button></form></section>
      <section class="settings-section" id="security"><div><h2>Security</h2><p class="muted">Change the password you use to sign in.</p></div><form class="page-form" action="/settings/password" method="post" data-live-form><label>Current password<input name="currentPassword" type="password" required></label><label>New password<input name="newPassword" type="password" minlength="8" required></label><button class="button secondary" type="submit">Update password</button></form></section>
      <section class="settings-section danger-zone" id="account"><div><h2>Delete account</h2><p class="muted">This permanently removes your profile, tasks, and group memberships.</p></div><form class="page-form" action="/settings/delete" method="post" data-live-form data-confirm-message="This permanently deletes your account. Continue?"><label>Type DELETE to confirm<input name="confirmation" autocomplete="off" required></label><label>Password<input name="password" type="password" required></label><button class="button danger" type="submit">Delete my account</button></form></section>
    </div>
  </div>
</section>
