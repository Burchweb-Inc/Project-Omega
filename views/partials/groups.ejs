<section class="content-wrap groups-page"><div class="page-heading hero-heading"><div><p class="eyebrow">YOUR SHARED SPACES</p><h1>Groups</h1><p class="lead">Administrative homes for your people, settings, visibility, and courses.</p></div><a class="button primary" href="/group/new"><i data-lucide="plus"></i> Create group</a></div><div class="group-grid"><% groups.forEach(group => { %><article class="group-card"><div class="group-card-head"><div><span class="eyebrow"><%= group.visibility === 'public' ? 'PUBLIC GROUP' : 'PRIVATE GROUP' %></span><h2><%= group.name %></h2></div><span class="member-limit"><%= group.members.length %> people</span></div><p class="muted"><%= group.description || 'A shared home for your people and courses.' %></p><div class="group-tools"><span><i data-lucide="book-open"></i> <%= group.courses.length %> courses</span><span><i data-lucide="shield-check"></i> <%= group.visibility %></span><span><i data-lucide="lock-keyhole"></i> Protected</span></div><div class="group-actions"><a class="button secondary" href="/group/<%= group.slug || group.id %>">Open group</a><% if (group.members.find(member => member.userId === user.id)?.role === 'admin') { %><a class="icon-link" href="/org/<%= group.id %>/settings" aria-label="Manage <%= group.name %>" title="Manage group"><i data-lucide="settings-2"></i></a><% } %></div></article><% }) %><% if (!groups.length) { %><div class="empty-panel"><i data-lucide="users-round"></i><h3>Create your first group</h3><p>Keep people, privacy, and course folders together.</p><a class="button primary" href="/group/new">Create group</a></div><% } %></div></section>