<section class="content-wrap sso-secret-page">
  <div class="page-heading hero-heading">
    <div>
      <p class="kicker"><%= rotated ? 'SECRET ROTATED' : 'INTEGRATION CREATED' %></p>
      <h1>Copy the secret now.</h1>
      <p class="lead">This is the only time LockIn will show this client secret. Store it in the integration's server environment, never in browser code.</p>
    </div>
  </div>

  <section class="admin-panel sso-secret-panel">
    <div class="form-success" role="status"><i data-lucide="circle-check"></i> <span>Keep this window open until both values are saved.</span></div>

    <div class="sso-secret-value">
      <span>Client ID</span>
      <code><%= ssoClient.clientId %></code>
      <button class="lui-button lui-button-secondary" type="button" data-copy-value="<%= ssoClient.clientId %>"><i data-lucide="copy"></i> Copy ID</button>
    </div>

    <div class="sso-secret-value">
      <span>Client secret</span>
      <code><%= clientSecret %></code>
      <button class="lui-button lui-button-primary" type="button" data-copy-value="<%= clientSecret %>"><i data-lucide="copy"></i> Copy secret</button>
    </div>

    <p class="muted">If the secret is lost or exposed, rotate it from the Developers tab. Rotation immediately invalidates existing authorization codes and access tokens for this integration.</p>

    <div class="sso-secret-redirects">
      <h2>Approved redirect URLs</h2>
      <ul>
        <% ssoClient.redirectUris.forEach((uri) => { %><li><code><%= uri %></code></li><% }) %>
      </ul>
    </div>

    <a class="lui-button lui-button-secondary" href="/site-admin?tab=developers"><i data-lucide="arrow-left"></i> Back to Developers</a>
  </section>
</section>
