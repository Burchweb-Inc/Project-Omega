<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LockIn | <%= status %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #172b4d;
      --ink-soft: #42607d;
      --muted: #71859a;
      --line: #dce6ef;
      --paper: #f4f7fa;
      --white: #fff;
      --blue: #2c6e9f;
      --coral: #e86f51;
    }

    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      color: var(--ink);
      background: var(--paper);
      font-family: 'DM Sans', sans-serif;
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      opacity: .35;
      background-image: linear-gradient(rgba(44, 110, 159, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(44, 110, 159, .035) 1px, transparent 1px);
      background-size: 42px 42px;
    }
    main {
      width: min(620px, 100%);
      padding: clamp(32px, 7vw, 72px);
      text-align: center;
      background: var(--white);
      border: 1px solid var(--line);
      box-shadow: 0 16px 42px rgba(29, 61, 91, .08);
    }
    .wordmark {
      display: inline-block;
      margin-bottom: 44px;
      color: var(--blue);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -.04em;
      text-decoration: none;
    }
    .status {
      margin: 0 0 12px;
      color: var(--coral);
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(56px, 14vw, 108px);
      font-weight: 700;
      letter-spacing: -.08em;
      line-height: .9;
    }
    h1 {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(24px, 4vw, 36px);
      letter-spacing: -.05em;
      line-height: 1.05;
    }
    p {
      max-width: 430px;
      margin: 18px auto 30px;
      color: var(--ink-soft);
      line-height: 1.6;
    }
    .button {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 0 18px;
      color: white;
      background: var(--blue);
      border: 0;
      font-weight: 700;
      text-decoration: none;
      transition: background .2s, transform .2s;
    }
    .button:hover { background: var(--ink); transform: translateY(-2px); }
    .button:focus-visible { outline: 3px solid rgba(232, 111, 81, .45); outline-offset: 3px; }
  </style>
</head>
<body>
  <main>
    <a class="wordmark" href="/" aria-label="LockIn home">LockIn</a>
    <p class="status" aria-label="Error <%= status %>"><%= status %></p>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a class="button" href="/">Back to LockIn</a>
  </main>
</body>
</html>
