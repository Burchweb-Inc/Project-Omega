<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page === 'landing' ? 'StudyHub' : `StudyHub | ${locals.selectedOrg?.name || 'Study space'}` %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/pages.css"><link rel="stylesheet" href="/router.css"><link rel="stylesheet" href="/ui-overrides.css"><script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="<%= page %>">
<% if (page === 'landing') { %>
  <%- include('partials/landing') %>
<% } else if (['about', 'support', 'privacy', 'terms', 'understand'].includes(page)) { %>
  <%- include('partials/public-shell', { view }) %>
<% } else { %>
  <%- include('partials/app-layout', { view }) %>
<% } %><script src="/socket.io/socket.io.js"></script><script src="/app.js"></script></body></html>