OPENROUTER_API_KEY=replace-with-openrouter-api-key

OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
BAD_WORD_REVIEW_INTERVAL_MINUTES=10
BAD_WORD_REVIEW_INTERVAL_MS=600000

APP_MODE=beta

# Mutation limits per IP. Defaults are 240/min generally and 30/min for auth and SSO.
# MUTATION_RATE_LIMIT=240
# AUTH_RATE_LIMIT=30
# MUTATION_RATE_WINDOW_MS=60000

# Set to 1 when one trusted reverse proxy forwards requests. Leave unset for direct access.
# TRUST_PROXY=1

# Public origin used for LockIn SSO discovery, issuers, and callbacks.
# Production requires a bare HTTPS origin.
PUBLIC_URL=http://localhost:3000

# First boot only, for a new database. Remove the password after the admin exists.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Log In With SnarkyType

SNARKYTYPE_CLIENT_ID=replace-with-snarkytype-client-id
SNARKYTYPE_CLIENT_SECRET=replace-with-snarkytype-client-secret

# Google Tasks API (OAuth web application credentials)
GOOGLE_TASKS_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_TASKS_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_TASKS_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# Apple Reminders CalDAV endpoint; each LockIn user supplies their own Apple ID and app-specific password.
APPLE_CALDAV_SERVER=https://caldav.icloud.com
